+#ifdef RS64_BYTE_WATCH
+#include <stdio.h>
+#include <stdlib.h>
+static inline void* rs64_bwatch(uint8_t* rdram, uint8_t* p, const char* fn) {
+    static int en = -1, n = 0;
+    if (en < 0) { const char* e = getenv("ROGUESQ_BOOLSTORE_WATCH"); en = (e && e[0]) ? 1 : 0; }
+    if (en && n < 4000) {
+        uint32_t a = (uint32_t)(p - rdram) ^ 3u; /* unswizzled phys addr */
+        if (a >= 0x13889Fu && a < 0x13891Fu) { n++; fprintf(stderr, "[boolstore] #%d fn=%s id=0x%X\n", n, fn, a - 0x13889Fu); }
+    }
+    return p;
+}
+#define MEM_B(offset, reg) \
+    (*(int8_t*)rs64_bwatch(rdram, rdram + ((((reg) + (offset)) ^ 3) - 0xFFFFFFFF80000000), __func__))
