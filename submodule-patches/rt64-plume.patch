+    // MARK: - RS64 allocation census (ROGUESQ_LOG_ALLOC=1)
+    //
+    // The Metal shared-memory exhaustion under ROGUESQ_DPC_WRAP=1 is not any of
+    // RT64's own caches (framebuffers, render targets, texture cache and frame
+    // size were all measured flat). These counters sit at the only three places
+    // that hand memory to the driver, so whatever grows shows up here.
+    namespace rs64_alloc {
+        static std::atomic<int64_t> bufferCount{0};
+        static std::atomic<int64_t> bufferBytes{0};
+        static std::atomic<int64_t> textureCount{0};
+        static std::atomic<int64_t> textureBytes{0};
+        static std::atomic<int64_t> descSetCount{0};
+        static std::atomic<int64_t> descSetBytes{0};
+        static std::atomic<int64_t> bufferMade{0};
+        static std::atomic<int64_t> textureMade{0};
+        static std::atomic<int64_t> descSetMade{0};
+
+        static bool enabled() {
+            static const bool on = getenv("ROGUESQ_LOG_ALLOC") != nullptr;
+            return on;
+        }
+
+        // Attribution: the counters say WHAT grows, this says WHO allocates it.
+        // Sampled rather than continuous so the cost stays negligible.
+        static void sampleStack(const char *tag, uint64_t size) {
+            void *frames[16];
+            const int count = backtrace(frames, 16);
+            char **symbols = backtrace_symbols(frames, count);
+            fprintf(stderr, "[alloc-stack %s] size=%llu\n", tag, (unsigned long long)size);
+            for (int i = 1; i < count; i++) {
+                fprintf(stderr, "    %s\n", symbols != nullptr ? symbols[i] : "?");
+            }
+
+            free(symbols);
+            fflush(stderr);
+        }
+
+        static void report(const char *tag) {
+            if (!enabled()) {
+                return;
+            }
+
+            static std::mutex mutex;
+            static std::chrono::steady_clock::time_point last;
+            std::lock_guard lock(mutex);
+            const auto now = std::chrono::steady_clock::now();
+            if (last.time_since_epoch().count() != 0 && (now - last) < std::chrono::seconds(2)) {
+                return;
+            }
+
+            last = now;
+            fprintf(stderr, "[alloc %s] buffers live=%lld (%.1f MB) made=%lld | textures live=%lld (%.1f MB) made=%lld | descsets live=%lld (%.2f MB) made=%lld\n",
+                tag,
+                (long long)bufferCount.load(), bufferBytes.load() / 1048576.0, (long long)bufferMade.load(),
+                (long long)textureCount.load(), textureBytes.load() / 1048576.0, (long long)textureMade.load(),
+                (long long)descSetCount.load(), descSetBytes.load() / 1048576.0, (long long)descSetMade.load());
+            fflush(stderr);
+        }
+    }
