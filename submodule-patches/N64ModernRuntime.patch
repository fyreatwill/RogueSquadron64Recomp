+static void audio_join_register_task(const AudioDmaProbe& probe,
+                                     uint32_t dmem_changed, bool canary_ok,
+                                     int exit) {
+    std::lock_guard<std::mutex> lock(g_audio_join_mutex);
+    AudioJoinTask task{};
+    task.n = probe.n;
+    task.canary_arm = probe.canary_arm;
+    task.phase = probe.phase;
+    task.width = probe.width;
+    task.origin = probe.origin;
+    task.begin_event = probe.begin_event;
+    task.end_event = probe.end_event;
+    task.dmem_changed = dmem_changed;
+    task.source_fnv = probe.source_fnv;
+    task.source_nz = probe.source_nz;
+    task.break_pc = probe.break_pc;
+    task.canary_ok = canary_ok;
+    task.exit = exit;
+    task.ranges.reserve(probe.ranges.size());
+    for (const AudioDmaRange& range : probe.ranges) {
+        task.ranges.push_back({range});
+    }
+    g_audio_join_tasks.push_back(std::move(task));
+    AudioJoinTask& registered = g_audio_join_tasks.back();
+    audio_join_match_task_locked(registered);
+    audio_join_report_locked(registered);
+}
