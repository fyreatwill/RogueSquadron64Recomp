+void log_vi_context_port_commit(int cur_state, uint32_t selected_field,
+                                uint32_t next_state, uint32_t mode_guest,
+                                uint32_t framebuffer, uint32_t width,
+                                const OSViMode* mode, uint32_t committed_origin,
+                                uint32_t current_line_bit) {
+    if (!vi_context_port_log_enabled()) return;
+
+    ViContextPortTrace& trace = vi_context_port_trace;
+    const uint32_t field0_origin = mode->fldRegs[0].origin;
+    const uint32_t field1_origin = mode->fldRegs[1].origin;
+    const uint32_t candidate0 = framebuffer + field0_origin;
+    const uint32_t candidate1 = framebuffer + field1_origin;
+
+    if (trace.all_width_prefix_rows < 8) {
+        const uint32_t prefix = trace.all_width_prefix_rows++;
+        std::fprintf(stderr,
+            "[vi-context-port-control] arm=%s prefix=%u width=%u cur_state=%d "
+            "state=0x%08X framebuffer=0x%08X mode=0x%08X committed=0x%08X\n",
+            vi_context_port_arm(), prefix, width, cur_state, next_state,
+            framebuffer, mode_guest, committed_origin);
+        std::fflush(stderr);
+    }
+
+    if (width != 640) return;
+
+    const uint32_t phase = trace.phase_ordinal++;
+    if (selected_field < 2) trace.field_rows[selected_field]++;
+    if (committed_origin == 0x00696100u) trace.commit_rows[0]++;
+    if (committed_origin == 0x00696600u) trace.commit_rows[1]++;
+    if (candidate0 == 0x00696100u) trace.candidate0_rows[0]++;
+    if (candidate0 == 0x00696600u) trace.candidate0_rows[1]++;
+    if (candidate1 == 0x00696100u) trace.candidate1_rows[0]++;
+    if (candidate1 == 0x00696600u) trace.candidate1_rows[1]++;
+    trace.current_line_rows[vi_context_port_origin_bucket(committed_origin)][current_line_bit & 1u]++;
+    trace.mode_v_current_rows[vi_context_port_origin_bucket(committed_origin)]
+        [mode->comRegs.vCurrent & 1u]++;
+
+    if (trace.rows < 512) {
+        trace.rows++;
+        std::fprintf(stderr,
+            "[vi-context-port] arm=%s phase=%u cur_state=%d field=%u "
+            "v_current=%u mode_v_current=%u "
+            "state=0x%08X framebuffer=0x%08X mode=0x%08X "
+            "fld0.origin=0x%08X fld0.yScale=0x%08X "
+            "fld1.origin=0x%08X fld1.yScale=0x%08X "
+            "candidate0=0x%08X candidate1=0x%08X committed=0x%08X\n",
+            vi_context_port_arm(), phase, cur_state, selected_field, current_line_bit,
+            mode->comRegs.vCurrent & 1u,
+            next_state,
+            framebuffer, mode_guest, field0_origin, mode->fldRegs[0].yScale,
+            field1_origin, mode->fldRegs[1].yScale, candidate0, candidate1,
+            committed_origin);
+        std::fflush(stderr);
+    } else {
+        trace.overflow++;
+    }
+
+    if ((trace.rows == 64 || trace.rows == 128 || trace.rows == 192 ||
+         trace.rows == 256 || trace.rows == 512) && trace.summaries < 5) {
+        trace.summaries++;
+        log_vi_context_port_summary();
+    }
+}
