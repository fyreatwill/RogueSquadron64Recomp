+extern "C" void rs64_audio_join_pcm(const char* kind, uint32_t phase,
+                                     uint32_t width, uint32_t origin,
+                                     uint32_t ordinal, uint32_t row,
+                                     uint32_t n, uint32_t rdram,
+                                     uint32_t samples, uint32_t bytes,
+                                     uint32_t fnv, uint32_t nonzero) {
+    std::lock_guard<std::mutex> lock(g_audio_join_mutex);
+    audio_image_scope_locked(phase, width, origin);
+    uint32_t writer_kind = 0;
+    uint32_t writer_pc = 0;
+    uint32_t writer_phys = 0;
+    uint32_t writer_writes = 0;
+    uint32_t writer_value = 0;
+    uint64_t writer_sequence = 0;
+    if (rs64_m5_pcm_writer_snapshot) {
+        rs64_m5_pcm_writer_snapshot(rdram, &writer_kind, &writer_pc,
+                                    &writer_phys, &writer_writes,
+                                    &writer_sequence, &writer_value);
+    }
+    const uint32_t callsite = rs64_m5_pcm_get_callsite ?
+        rs64_m5_pcm_get_callsite() : 0u;
+    AudioJoinPcm pcm{};
+    pcm.source = std::strcmp(kind, "source") == 0;
+    pcm.event = audio_join_next_event();
+    pcm.phase = phase;
+    pcm.width = width;
+    pcm.origin = origin;
+    pcm.ordinal = ordinal;
+    pcm.row = row;
+    pcm.n = n;
+    pcm.rdram = rdram;
+    pcm.samples = samples;
+    pcm.bytes = bytes;
+    pcm.fnv = fnv;
+    pcm.nonzero = nonzero;
+    g_audio_join_pcm.push_back(pcm);
+    fprintf(stderr,
+            "[audio-join-pcm] kind=%s event=%" PRIu64 " n=%u phase=%u"
+            " width=%u origin=0x%06X ordinal=%u row=%u guest=0x%06X"
+            " samples=%u bytes=%u"
+            " fnv=%08X nz=%u callsite=0x%08X writer_kind=%u"
+            " writer_pc=0x%08X writer_phys=0x%06X writer_writes=%u"
+            " writer_sequence=%" PRIu64 " writer_value=0x%08X\n",
+            kind, pcm.event, n, phase, width, origin, ordinal, row, rdram, samples, bytes,
+            fnv, nonzero, callsite, writer_kind, writer_pc, writer_phys,
+            writer_writes, writer_sequence, writer_value);
+    audio_join_match_pcm_locked(g_audio_join_pcm.size() - 1);
+    audio_image_match_pcm_locked(g_audio_join_pcm.size() - 1);
+}
