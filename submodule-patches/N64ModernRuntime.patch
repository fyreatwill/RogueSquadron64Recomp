+extern "C" uint64_t rs64_audio_join_m5_event(
+    const char* kind, uint32_t site, uint32_t active, const char* arm,
+    uint32_t phase, uint32_t width, uint32_t origin, uint32_t ordinal,
+    uint32_t row, uint32_t idx, uint32_t dest, uint32_t value0,
+    uint32_t value1, uint32_t value2, uint32_t value3) {
+    std::lock_guard<std::mutex> lock(g_audio_join_mutex);
+    const uint64_t event = audio_join_next_event();
+    const bool is_slot = kind != nullptr && std::strcmp(kind, "slot-sb") == 0;
+    const bool is_keyon = kind != nullptr && std::strcmp(kind, "keyon-w40") == 0;
+    if (is_slot || is_keyon) {
+        for (AudioImageStage& stage : g_audio_image_stages) {
+            if (stage.dma_event == 0 || stage.ordinal != ordinal ||
+                stage.row != row || stage.phase != phase ||
+                stage.width != width || stage.origin != origin ||
+                std::strcmp(stage.arm, arm ? arm : "n/a") != 0 ||
+                event <= stage.dma_event) continue;
+            if (is_slot && stage.first_slot_event == 0) {
+                stage.first_slot_event = event;
+                stage.first_slot_kind = kind;
+                stage.first_slot_site = site;
+            }
+            if (is_keyon && stage.first_keyon_event == 0) {
+                stage.first_keyon_event = event;
+                stage.first_keyon_kind = kind;
+                stage.first_keyon_site = site;
+            }
+            if ((is_slot && stage.first_slot_event == event) ||
+                (is_keyon && stage.first_keyon_event == event)) {
+                std::fprintf(stderr,
+                    "[audtask-image-downstream] arm=%s ordinal=%u row=%u"
+                    " phase=%u width=%u origin=0x%06X stage=%u dma_event=%" PRIu64
+                    " event=%" PRIu64 " kind=%s site=0x%08X idx=%u dest=0x%08X"
+                    " slot_event=%" PRIu64 " keyon_event=%" PRIu64 "\n",
+                    stage.arm, stage.ordinal, stage.row, stage.phase, stage.width,
+                    stage.origin, stage.stage, stage.dma_event, event,
+                    kind ? kind : "n/a", site, idx, dest,
+                    stage.first_slot_event, stage.first_keyon_event);
+                std::fflush(stderr);
+            }
+        }
+    }
+    if (is_keyon) {
+        static bool identity_control_logged = false;
+        if (!identity_control_logged) {
+            size_t eligible = 0;
+            for (const AudioImageStage& stage : g_audio_image_stages) {
+                if (!stage.identity_table_logged && event > stage.stage_event) {
+                    ++eligible;
+                }
+            }
+            std::fprintf(stderr,
+                "[m5-identity-control] event=%" PRIu64
+                " phase=%u width=%u origin=0x%06X ordinal=%u row=%u"
+                " stages=%zu eligible=%zu\n",
+                event, phase, width, origin, ordinal, row,
+                g_audio_image_stages.size(), eligible);
+            std::fflush(stderr);
+            identity_control_logged = true;
+        }
+        for (AudioImageStage& stage : g_audio_image_stages) {
+            if (stage.identity_table_logged || event <= stage.stage_event) continue;
+            stage.identity_keyon_event = event;
+            stage.identity_keyon_site = site;
+            stage.identity_table_logged = true;
+            const bool phase_key = stage.width == width && stage.origin == origin;
+            const bool ordinal_key = stage.ordinal == ordinal && stage.row == row;
+            const bool sequence_key = event <= stage.stage_event + 64u;
+            const uint32_t classification = phase_key ?
+                (ordinal_key ? (sequence_key ? 7u : 3u) : (sequence_key ? 5u : 1u)) :
+                (ordinal_key ? (sequence_key ? 6u : 2u) : (sequence_key ? 4u : 0u));
+            std::fprintf(stderr,
+                "[m5-identity-table] arm=%s stage_ordinal=%u stage_row=%u"
+                " stage_phase=%u stage_width=%u stage_origin=0x%06X"
+                " stage=%u stage_event=%" PRIu64 " keyon_event=%" PRIu64
+                " keyon_site=0x%08X event_phase=%u event_width=%u"
+                " event_origin=0x%06X event_ordinal=%u event_row=%u"
+                " phase_key=%u ordinal_key=%u sequence_key=%u class=%u\n",
+                stage.arm ? stage.arm : "n/a", stage.ordinal, stage.row,
+                stage.phase, stage.width, stage.origin, stage.stage,
+                stage.stage_event, event, site, phase, width, origin,
+                ordinal, row, phase_key ? 1u : 0u, ordinal_key ? 1u : 0u,
+                sequence_key ? 1u : 0u, classification);
+            std::fflush(stderr);
+        }
+    }
+    fprintf(stderr,
+            "[m5-audio-event] kind=%s event=%" PRIu64
+            " active=%u arm=%s phase=%u width=%u origin=0x%06X"
+            " ordinal=%u row=%u site=0x%08X idx=%u dest=0x%08X"
+            " value0=0x%08X value1=0x%08X value2=0x%08X value3=0x%08X\n",
+            kind ? kind : "n/a", event, active, arm ? arm : "n/a", phase,
+            width, origin, ordinal, row, site, idx, dest, value0, value1,
+            value2, value3);
+    fflush(stderr);
+    return event;
+}
