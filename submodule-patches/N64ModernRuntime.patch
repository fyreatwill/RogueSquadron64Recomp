+static uint32_t audio_read_rdram_word(const uint8_t* rdram, uint32_t addr) {
+    // s7601 class BS: guest byte A is rdram[A ^ 3]; the old rdram[addr+0]<<24.. composition returned the byte-reversed word.
+    return (static_cast<uint32_t>(rdram[((addr + 0u) ^ 3u) & 0x007FFFFFu]) << 24) |
+           (static_cast<uint32_t>(rdram[((addr + 1u) ^ 3u) & 0x007FFFFFu]) << 16) |
+           (static_cast<uint32_t>(rdram[((addr + 2u) ^ 3u) & 0x007FFFFFu]) << 8) |
+           static_cast<uint32_t>(rdram[((addr + 3u) ^ 3u) & 0x007FFFFFu]);
+}
