+static bool audio_dma_overlaps(uint32_t dram, uint32_t len, int32_t ptr,
+                               int32_t size) {
+    const uint32_t start = static_cast<uint32_t>(ptr) & 0x007FFFFFu;
+    const uint32_t span = static_cast<uint32_t>(size);
+    if (span == 0 || start >= 0x800000u) return false;
+    const uint64_t end = static_cast<uint64_t>(start) + span;
+    return static_cast<uint64_t>(dram) < end &&
+           static_cast<uint64_t>(dram) + len > start;
+}
+
+static void audio_hash_rdram(const uint8_t* rdram, uint32_t addr, uint32_t len,
+                             uint32_t& fnv, uint32_t& nonzero) {
+    fnv = 2166136261u;
+    nonzero = 0;
+    for (uint32_t i = 0; i < len; i++) {
+        const uint8_t b = rdram[(addr + i) & 0x007FFFFFu];
+        fnv = (fnv * 16777619u) ^ b;
+        nonzero += b != 0;
+    }
+}
+
+static uint32_t audio_read_rdram_word(const uint8_t* rdram, uint32_t addr) {
+    return (static_cast<uint32_t>(rdram[(addr + 0u) & 0x007FFFFFu]) << 24) |
+           (static_cast<uint32_t>(rdram[(addr + 1u) & 0x007FFFFFu]) << 16) |
+           (static_cast<uint32_t>(rdram[(addr + 2u) & 0x007FFFFFu]) << 8) |
+           static_cast<uint32_t>(rdram[(addr + 3u) & 0x007FFFFFu]);
+}
