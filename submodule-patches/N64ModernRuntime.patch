+extern "C" volatile uint32_t g_rs64_last_guest_pc;
+static void rs64_s4214_scan(uint8_t* rdram, const OSTask* task, uint32_t phase, unsigned n) {
+    static uint8_t prev[96 * 0x50 + 0x30]; static uint32_t prev_dp; static bool have;
+    uint32_t dp = (uint32_t)task->t.data_ptr; uint32_t off = dp & 0x1FFFFFFFu;
+    if (off == 0 || off + sizeof(prev) > (rs64_ram_top - 0x80000000u)) return;
+    const uint8_t* b = rdram + off;
+    uint8_t cur[sizeof(prev)];
+    for (size_t i = 0; i < sizeof(cur); i++) cur[i] = b[i ^ 3]; // guest byte order (rdram word-swapped)
+    unsigned ascii = 0, zero = 0, ascii_recs = 0, zero_recs = 0, changed = 0, first_non = 96, first_nz_non = 96;
+    for (unsigned r = 0; r < 96; r++) {
+        unsigned a = 0, z = 0;
+        for (unsigned k = 0; k < 0x50; k++) { uint8_t c = cur[0x30 + r * 0x50 + k]; if (c >= 0x20 && c < 0x7F) a++; if (c == 0) z++; }
+        ascii += a; zero += z;
+        if (z == 0x50) zero_recs++;
+        if (a >= 0x30) ascii_recs++; else { if (first_non == 96) first_non = r; if (z != 0x50 && first_nz_non == 96) first_nz_non = r; }
+    }
+    if (have && prev_dp == dp) for (size_t i = 0; i < sizeof(cur); i++) changed += cur[i] != prev[i];
+    else changed = 0xFFFFFFFFu;
+    memcpy(prev, cur, sizeof(cur)); prev_dp = dp; have = true;
+    if (n <= 8 || n % 64 == 0) {
+        uint32_t cnt = (uint32_t)task->t.data_size; if (cnt > 4) cnt = 4;
+        auto rd32 = [&](uint32_t a) { uint32_t v = 0; for (int k = 0; k < 4; k++) v = (v << 8) | rdram[((a + k) & 0x007FFFFFu) ^ 3]; return v; };
+        auto rd16 = [&](uint32_t a) { return (uint32_t)((rdram[(a & 0x007FFFFFu) ^ 3] << 8) | rdram[((a + 1) & 0x007FFFFFu) ^ 3]); };
+        for (uint32_t f = 0; f < cnt; f++) {
+            uint32_t base = off + f * 0xA10u; unsigned active = 0; uint32_t output = 0;
+            for (uint32_t v = 0; v < 32; v++) {
+                uint32_t va = base + 0x10 + v * 0x50;
+                output = rd32(va + 0x44);
+                if (rd16(va + 0x2C) == 0) break;
+                active++;
+                if (output) break;
+            }
+            std::fprintf(stderr, "[s4218-act] phase=%u n=%u frame=%u base=%08X h0=%08X state=%08X active=%u output=%08X first=", phase, n, f, base, rd32(base), rd32(base + 8), active, output);
+            for (uint32_t i = 0; i < 0x50; i += 4) std::fprintf(stderr, "%08X,", rd32(base + 0x10 + i));
+            std::fprintf(stderr, "\n");
+        }
+    }
+    if (n <= 6 || (n & (n - 1)) == 0) {
+        std::fprintf(stderr, "[s4214-scan] phase=%u n=%u dp=0x%08X ascii_bytes=%u zero_bytes=%u ascii_recs=%u zero_recs=%u first_nonascii_rec=%u first_nz_nonascii_rec=%u changed=%d hdr=%02X%02X%02X%02X rec0=%02X%02X%02X%02X%02X%02X%02X%02X\n",
+            phase, n, dp, ascii, zero, ascii_recs, zero_recs, first_non, first_nz_non, (int)changed,
+            cur[0], cur[1], cur[2], cur[3], cur[0x30], cur[0x31], cur[0x32], cur[0x33], cur[0x34], cur[0x35], cur[0x36], cur[0x37]);
+    }
+}
+static void rs64_s4213_census(const OSTask* task) {
+    static const bool on = [] { const char* e = std::getenv("ROGUESQ_LOG_S4213"); return e && e[0] && e[0] != '0'; }();
+    if (!on) return;
+    static uint32_t ph_key = 0xFFFFFFFFu; static unsigned cnt[16]; static unsigned total;
+    uint32_t phase = rs64_phase_ord();
+    if (phase != ph_key) { ph_key = phase; for (auto& c : cnt) c = 0; total = 0; }
+    uint32_t ty = static_cast<uint32_t>(task->t.type);
+    total++; unsigned n = ++cnt[ty & 15];
