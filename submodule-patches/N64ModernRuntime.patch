+
+void log_vi_parity_scheduler_commit(uint64_t callback_ordinal,
+                                    uint64_t current_total_vis,
+                                    uint64_t delta_total_vis,
+                                    uint32_t selected_field,
+                                    uint32_t current_line_bit,
+                                    uint32_t committed_origin,
+                                    uint32_t width) {
+    if (!vi_parity_scheduler_log_enabled() || callback_ordinal == 0) return;
