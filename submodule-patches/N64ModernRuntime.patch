+static void audio_image_source_census_locked(uint32_t phase, uint32_t width,
+                                             uint32_t origin) {
+    size_t source_rows = 0;
+    size_t same_generation = 0;
+    size_t reversed = 0;
+    size_t absent_generation = 0;
+    size_t zero_generation = 0;
+    for (const AudioImageSource& source : g_audio_image_sources) {
+        if (source.phase != phase || source.width != width ||
+            source.origin != origin) continue;
+        ++source_rows;
+        if (source.task_generation == 0) {
+            ++zero_generation;
+            continue;
+        }
+        bool found_generation = false;
+        bool found_after = false;
+        for (const AudioImageStage& stage : g_audio_image_stages) {
+            if (stage.phase != phase || stage.width != width ||
+                stage.origin != origin || stage.task_generation != source.task_generation ||
+                std::strcmp(stage.arm ? stage.arm : "n/a",
+                            source.arm ? source.arm : "n/a") != 0) continue;
+            found_generation = true;
+            if (stage.stage_event >= source.source_event) found_after = true;
+        }
+        if (!found_generation) ++absent_generation;
+        else if (found_after) ++same_generation;
+        else ++reversed;
+    }
+    fprintf(stderr,
+            "[audtask-image-source-census] phase=%u width=%u origin=0x%06X"
+            " source_rows=%zu same_generation=%zu reversed=%zu"
+            " absent_generation=%zu zero_generation=%zu stage_rows=%zu\n",
+            phase, width, origin, source_rows, same_generation, reversed,
+            absent_generation, zero_generation, g_audio_image_stages.size());
+    fflush(stderr);
