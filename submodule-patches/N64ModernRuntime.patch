+extern "C" { uint32_t rs64_s4208_dma[4096][3]; uint32_t rs64_s4208_n; int rs64_s4208_active; }
+extern "C" { uint32_t rs64_s4209_rd[4096][5]; uint32_t rs64_s4209_n; }
+extern "C" void rs64_s4209_read(uint8_t* rdram, uint32_t dram_addr, uint32_t len, uint32_t dmem_addr) {
+    if (!rs64_s4208_active || rs64_s4209_n >= 4096u) return;
+    uint32_t s = 0, d = 0;
+    for (uint32_t i = 0; i < len; i++) {
+        s += rdram[(dram_addr + i) & 0x007FFFFFu] != 0;
+        d += RSP_MEM_BU(0, dmem_addr + i) != 0;
+    }
+    uint32_t* r = rs64_s4209_rd[rs64_s4209_n++];
+    r[0] = dram_addr & 0x007FFFFFu; r[1] = len; r[2] = s; r[3] = d; r[4] = dmem_addr;
+}
+extern "C" { uint32_t rs64_s4210_cmd[512][12]; uint32_t rs64_s4210_n; }
+extern "C" void rs64_s4210_cmd_rec(uint32_t src) {
+    if (!rs64_s4208_active || rs64_s4210_n >= 512u) return;
+    uint32_t nz = 0;
+    for (uint32_t i = 0; i < 0x50; i++) nz += RSP_MEM_BU(0, 0x350 + i) != 0;
+    auto w = [](uint32_t o) { return (uint32_t)(RSP_MEM_BU(0, 0x350 + o) << 24 | RSP_MEM_BU(0, 0x351 + o) << 16 | RSP_MEM_BU(0, 0x352 + o) << 8 | RSP_MEM_BU(0, 0x353 + o)); };
+    uint32_t* r = rs64_s4210_cmd[rs64_s4210_n++];
+    r[0] = src; r[1] = nz; r[2] = w(0x3C); r[3] = w(0x40); r[4] = w(0x2C);
+    r[5] = w(0x00); r[6] = w(0x04); r[7] = w(0x08); r[8] = w(0x0C); r[9] = w(0x24); r[10] = w(0x30); r[11] = w(0x38);
+}
+extern "C" void rs64_s4210_summary(void) {
+    static uint32_t ph_key = 0xFFFFFFFFu;
+    static unsigned long tasks, cmds, cmd_nz0, b3c_nz, b3d_nz, h2c_nz, h40_nz, ctrl_nz, wr_total, wr_nz;
+    uint32_t phase = rs64_phase_ord();
+    if (phase != ph_key) { ph_key = phase; tasks = cmds = cmd_nz0 = b3c_nz = b3d_nz = h2c_nz = h40_nz = ctrl_nz = wr_total = wr_nz = 0; }
+    tasks++;
+    uint32_t n = rs64_s4210_n;
+    cmds += n;
+    for (uint32_t i = 0; i < n; i++) {
+        const uint32_t* r = rs64_s4210_cmd[i];
+        if (r[1] == 0) cmd_nz0++;
+        if (r[2] >> 24) b3c_nz++;
+        if ((r[2] >> 16) & 0xFF) b3d_nz++;
+        if (r[4] >> 16) h2c_nz++;
+        if (r[3] >> 16) h40_nz++;
+        if (r[1] != 0) ctrl_nz++;
+    }
+    uint32_t nw = rs64_s4208_n;
+    for (uint32_t i = 0; i < nw; i++) { wr_total++; if (rs64_s4208_dma[i][2]) wr_nz++; }
+    if (tasks <= 3 || (tasks % 128ul) == 0) {
+        std::fprintf(stderr, "[m5-cmd] phase=%u task=%lu cmds=%u cum_cmds=%lu empty_struct=%lu b3c_nz=%lu b3d_nz=%lu h2c_nz=%lu h40_nz=%lu struct_nz=%lu | writes_this=%u cum_writes=%lu cum_writes_nz=%lu\n",
+                     phase, tasks, n, cmds, cmd_nz0, b3c_nz, b3d_nz, h2c_nz, h40_nz, ctrl_nz, nw, wr_total, wr_nz);
+        for (uint32_t i = 0; i < nw && i < 8; i++)
+            std::fprintf(stderr, "[m5-cmd]   w%u dram=0x%06X len=%u nz=%u\n", i, rs64_s4208_dma[i][0], rs64_s4208_dma[i][1], rs64_s4208_dma[i][2]);
+        for (uint32_t i = 0; i < n && i < 6; i++) {
+            const uint32_t* r = rs64_s4210_cmd[i];
+            std::fprintf(stderr, "[m5-cmd]   c%u src=0x%06X nz=%u b3c..3f=%08X h40,42=%08X h2c=%08X w0=%08X w4=%08X w8=%08X wC=%08X w24=%08X w30=%08X w38=%08X\n",
+                         i, r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10], r[11]);
+        }
+        std::fprintf(stderr, "[m5-cmd]   dmem_nz/256B:");
+        for (uint32_t c = 0; c < 16; c++) { uint32_t z = 0; for (uint32_t i = 0; i < 256; i++) z += RSP_MEM_BU(0, c * 256 + i) != 0; std::fprintf(stderr, " %u", z); }
+        std::fputc('\n', stderr);
+        std::fflush(stderr);
+    }
+}
+struct Rs64S4211Pi { uint32_t dram, size, rom_off, phase, pc; };
+extern Rs64S4211Pi rs64_s4211_pi_ring[8192];
+extern uint64_t rs64_s4211_pi_n;
+extern "C" void rs64_s4211_task(uint8_t* rdram, uint32_t dp_virt) {
+    struct Slot { uint32_t dp; uint32_t hash; uint64_t tasks, changes, first_phase; };
+    static Slot slots[32]; static int nslots;
+    static uint32_t ph_key = 0xFFFFFFFFu; static unsigned long ph_tasks, ph_changes;
+    uint32_t phase = rs64_phase_ord();
+    if (phase != ph_key) { ph_key = phase; ph_tasks = ph_changes = 0; }
+    const uint32_t dp = dp_virt & 0x7FFFFFu;
+    const uint32_t lo = dp - 0x10, len = 0x130;
+    auto byte = [&](uint32_t p) { return rdram[(p) ^ 3]; };
+    uint32_t h = 2166136261u;
+    for (uint32_t i = 0; i < len; i++) { h ^= byte(lo + i); h *= 16777619u; }
+    Slot* s = nullptr;
+    for (int i = 0; i < nslots; i++) if (slots[i].dp == dp) s = &slots[i];
+    ph_tasks++;
+    if (!s) {
+        if (nslots >= 32) return;
+        s = &slots[nslots++]; *s = Slot{dp, h, 0, 0, phase};
+        std::fprintf(stderr, "[s4211-new] phase=%u dp=0x%06X pi_ring_total=%llu ascii0x10=\"", phase, dp, (unsigned long long)rs64_s4211_pi_n);
+        for (uint32_t i = 0; i < 0x30; i++) { uint8_t c = byte(dp + i); std::fputc((c >= 32 && c < 127) ? c : '.', stderr); }
+        std::fprintf(stderr, "\"\n");
+        uint64_t total = rs64_s4211_pi_n, avail = total < 8192 ? total : 8192; int hits = 0;
+        for (uint64_t k = 0; k < avail && hits < 4; k++) {
+            const Rs64S4211Pi& e = rs64_s4211_pi_ring[(total - 1 - k) % 8192];
+            if (e.dram < lo + len && e.dram + e.size > lo) {
+                std::fprintf(stderr, "[s4211-pi-hit] dp=0x%06X age=%llu dram=0x%06X size=0x%X rom_off=0x%08X dma_phase=%u guest_pc=0x%08X\n", dp, (unsigned long long)k, e.dram, e.size, e.rom_off, e.phase, e.pc);
+                hits++;
+            }
+        }
+        if (avail) {
+            const Rs64S4211Pi& e = rs64_s4211_pi_ring[(total - 1) % 8192];
+            std::fprintf(stderr, "[s4211-ctl] dp=0x%06X pi_hits=%d newest_dma=0x%06X+0x%X self_overlap=%d\n", dp, hits, e.dram, e.size, (int)(e.size > 0 && e.dram < e.dram + e.size));
+        } else std::fprintf(stderr, "[s4211-ctl] dp=0x%06X pi_hits=%d ring_empty\n", dp, hits);
+        std::fflush(stderr);
+        return;
+    }
+    s->tasks++;
+    if (h != s->hash) {
+        s->changes++; ph_changes++; s->hash = h;
