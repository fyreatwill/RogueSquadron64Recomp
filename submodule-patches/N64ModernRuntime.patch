+extern "C" void rs64_audio_join_image_dma(
+    const char* arm, uint32_t ordinal, uint32_t row, uint32_t phase,
+    uint32_t width, uint32_t origin, uint64_t dma_event, uint32_t dram,
+    uint32_t len, uint32_t fnv, uint32_t nonzero,
+    uint32_t source_dmem_fnv, uint32_t source_dmem_nonzero,
+    uint64_t source_event, uint64_t task_generation,
+    uint32_t latest_route_seq, uint32_t latest_route_ordinal,
+    uint32_t latest_route_row) {
+    std::lock_guard<std::mutex> lock(g_audio_join_mutex);
+    audio_image_scope_locked(phase, width, origin);
+    int best = -1;
+    for (size_t i = 0; i < g_audio_image_stages.size(); ++i) {
+        AudioImageStage& stage = g_audio_image_stages[i];
+        if (stage.dma_event != 0 || stage.ordinal != ordinal ||
+            stage.row != row || stage.phase != phase || stage.width != width ||
+            stage.origin != origin || std::strcmp(stage.arm, arm) != 0 ||
+            stage.dest != (dram & 0x007FFFFFu) || stage.len != len) continue;
+        best = static_cast<int>(i);
+        break;
+    }
+    if (best < 0) return;
+    AudioImageStage& stage = g_audio_image_stages[best];
+    stage.dma_event = dma_event;
+    stage.dma_dram = dram & 0x007FFFFFu;
+    stage.dma_len = len;
+    stage.dma_fnv = fnv;
+    stage.dma_nonzero = nonzero;
+    stage.source_dmem_fnv = source_dmem_fnv;
+    stage.source_dmem_nonzero = source_dmem_nonzero;
+    audio_image_match_stage_locked(stage);
+    fprintf(stderr,
+            "[audtask-image-dma-join] arm=%s ordinal=%u row=%u phase=%u"
+            " width=%u origin=0x%06X dma_event=%" PRIu64
+            " dram=0x%06X len=0x%X fnv=%08X nz=%u stage=%u"
+            " stage_event=%" PRIu64 " source_dmem_fnv=%08X source_dmem_nz=%u"
+            " source_event=%" PRIu64 " task_generation=%" PRIu64
+            " latest_route_seq=%u latest_route_ordinal=%u latest_route_row=%u"
+            " post_transform_fnv=%08X post_transform_nz=%u"
+            " destination_fnv=%08X destination_nz=%u\n",
+            arm ? arm : "n/a", ordinal, row, phase, width, origin, dma_event,
+            stage.dma_dram, len, fnv, nonzero, stage.stage,
+            stage.stage_event, stage.source_dmem_fnv, stage.source_dmem_nonzero,
+            source_event, task_generation, latest_route_seq,
+            latest_route_ordinal, latest_route_row,
+            stage.fnv, stage.nonzero, fnv, nonzero);
+    fflush(stderr);
+}
