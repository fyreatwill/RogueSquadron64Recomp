+// s7088-begin: retail osAiSetFrequency arithmetic, transcribed from the ROM (0x80029D20):
+// f = (float)osViClock / (float)freq + 0.5f (cvt.s.w, +2^32 if freq < 0), dacRate = cvt.w.s with
+// FCSR RM=1 (truncate; the f >= 2^31 overflow path needs freq == 0, never passed), return
+// -1 if dacRate < 132, else osViClock / (s32)dacRate. The previous integer form
+// (clock + freq/2) / freq differed for 21 inputs in 368..200000 (tools/s7088_shim_test).
+static inline int32_t rs64_ai_set_frequency_retail(uint32_t freq, uint32_t clock) {
+    volatile float ff = (float)(int32_t)freq;
+    if ((int32_t)freq < 0) ff = ff + 4294967296.0f;
+    volatile float q = (float)(int32_t)clock / ff;
+    volatile float f = q + 0.5f;
+    if (!(f < 2147483648.0f)) return -1; // dacRate would be >= 2^31: retail path unreachable here
+    const uint32_t dacRate = (uint32_t)(int32_t)f;
+    if (dacRate < 132u) return -1;
+    return (int32_t)clock / (int32_t)dacRate;
+}
+// s7088-end
 
