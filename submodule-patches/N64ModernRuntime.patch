+        if (stage.consumer_pcm >= 0) ++consumer_matches;
+        if (stage.complete_event != 0 && stage.source_pcm < 0 &&
+            stage.consumer_pcm < 0) ++stage_only;
+        if (stage.nonzero == 0 && stage.complete_event != 0) ++zero_completed;
+        if (stage.nonzero == 0 && stage.complete_event != 0 &&
+            stage.source_pcm < 0 && stage.consumer_pcm < 0) ++zero_stage_only;
+        const AudioJoinPcm* source = stage.source_pcm >= 0 ?
+            &g_audio_join_pcm[stage.source_pcm] : nullptr;
+        const AudioJoinPcm* consumer = stage.consumer_pcm >= 0 ?
+            &g_audio_join_pcm[stage.consumer_pcm] : nullptr;
+        if (stage.complete_event != 0 &&
+            (stage.complete_event <= stage.stage_event ||
+             (source && stage.complete_event >= source->event) ||
+             (consumer && stage.complete_event >= consumer->event) ||
+             (source && consumer && source->event >= consumer->event))) {
+            ++ordering_violations;
+        }
+    }
+    const uint32_t phase = static_cast<uint32_t>(g_audio_image_scope_key >> 40);
+    const uint32_t width = static_cast<uint32_t>((g_audio_image_scope_key >> 24) & 0xFFFFu);
+    const uint32_t origin = static_cast<uint32_t>(g_audio_image_scope_key & 0xFFFFFFu);
+    fprintf(stderr,
+            "[audtask-image-summary] phase=%u width=%u origin=0x%06X"
+            " stage_rows=%zu nonzero_stage_rows=%zu zero_stage_rows=%zu"
+            " zero_completed=%zu zero_stage_only=%zu source_matches=%zu"
+            " consumer_matches=%zu stage_only=%zu"
+            " consumer_only_observed=%u ordering_violations=%zu\n",
+            phase, width, origin, g_audio_image_stages.size(), nonzero,
+            zero, zero_completed, zero_stage_only, source_matches,
+            consumer_matches, stage_only,
+            g_audio_image_consumer_only, ordering_violations);
+    fflush(stderr);
+}
+
+static void audio_image_scope_locked(uint32_t phase, uint32_t width,
+                                     uint32_t origin) {
+    const uint64_t key = (static_cast<uint64_t>(phase) << 40) |
+        (static_cast<uint64_t>(width) << 24) | (origin & 0xFFFFFFu);
+    if (key == g_audio_image_scope_key) return;
+    audio_image_summary_locked();
+    if (g_audio_image_scope_key != UINT64_MAX) {
+        const uint32_t old_phase = static_cast<uint32_t>(g_audio_image_scope_key >> 40);
+        const uint32_t old_width = static_cast<uint32_t>((g_audio_image_scope_key >> 24) & 0xFFFFu);
+        const uint32_t old_origin = static_cast<uint32_t>(g_audio_image_scope_key & 0xFFFFFFu);
+        audio_image_source_census_locked(old_phase, old_width, old_origin);
+    }
+    g_audio_image_scope_key = key;
+    g_audio_image_consumer_only = 0;
+}
+
+static void audio_image_match_stage_locked(AudioImageStage& stage) {
+    auto choose = [&](bool source_kind, int& slot) {
+        if (slot >= 0) return;
+        int best = -1;
+        uint64_t best_distance = UINT64_MAX;
+        for (size_t i = 0; i < g_audio_join_pcm.size(); ++i) {
+            const AudioJoinPcm& pcm = g_audio_join_pcm[i];
+            const bool already_used = source_kind ? pcm.image_source_used :
+                pcm.image_consumer_used;
+            if (pcm.source != source_kind || already_used ||
+                pcm.event <= stage.dma_event || !audio_image_match(stage, pcm)) continue;
+            const uint64_t distance = pcm.event > stage.stage_event ?
+                pcm.event - stage.stage_event : stage.stage_event - pcm.event;
+            if (distance < best_distance) {
+                best = static_cast<int>(i);
+                best_distance = distance;
+            }
+        }
+        if (best >= 0) slot = best;
+    };
+    choose(true, stage.source_pcm);
+    choose(false, stage.consumer_pcm);
+    audio_image_report_locked(stage);
+}
+
+static void audio_image_match_source_locked(AudioImageStage& stage) {
+    if (stage.source_match != 0) return;
+    int exact = -1;
+    int prior = -1;
+    for (size_t i = 0; i < g_audio_image_sources.size(); ++i) {
+        const AudioImageSource& source = g_audio_image_sources[i];
+        if (source.phase != stage.phase || source.width != stage.width ||
+            source.origin != stage.origin || source.task_data_ptr == 0 ||
+            source.task_data_ptr != stage.task_data_ptr ||
+            source.ordinal != stage.ordinal || source.row != stage.row ||
+            std::strcmp(source.arm ? source.arm : "n/a",
+                        stage.arm ? stage.arm : "n/a") != 0) continue;
+        if (source.join_event <= stage.stage_event &&
+            (exact < 0 || source.join_event >
+             g_audio_image_sources[exact].join_event)) exact = static_cast<int>(i);
+    }
+    if (exact >= 0) {
+        const AudioImageSource& source = g_audio_image_sources[exact];
+        stage.source_match = 1;
+        stage.source_join_event = source.join_event;
+        stage.source_event = source.source_event;
+        stage.source_task_data_ptr = source.task_data_ptr;
+        stage.source_route_ordinal = source.ordinal;
+        stage.source_route_row = source.row;
+        stage.source_input_fnv = source.input_fnv;
+        stage.source_input_nonzero = source.input_nonzero;
+        stage.source_input_dram = source.input_dram;
+        stage.source_input_len = source.input_len;
+        stage.source_input_dmem = source.input_dmem;
+        stage.source_input_task_data_ptr = source.input_task_data_ptr;
+        stage.source_age = stage.stage_event - source.join_event;
+        return;
+    }
+    int generation = -1;
+    for (size_t i = 0; i < g_audio_image_sources.size(); ++i) {
+        const AudioImageSource& source = g_audio_image_sources[i];
+        if (source.phase != stage.phase || source.width != stage.width ||
+            source.origin != stage.origin || source.join_event > stage.stage_event ||
+            source.task_generation == 0 ||
+            source.task_generation != stage.task_generation ||
+            std::strcmp(source.arm ? source.arm : "n/a",
+                        stage.arm ? stage.arm : "n/a") != 0) continue;
+        if (generation < 0 || source.join_event >
+                             g_audio_image_sources[generation].join_event) {
+            generation = static_cast<int>(i);
+        }
+    }
+    if (generation >= 0) {
+        const AudioImageSource& source = g_audio_image_sources[generation];
+        stage.source_match = 4;
+        stage.source_join_event = source.join_event;
+        stage.source_event = source.source_event;
+        stage.source_task_generation = source.task_generation;
+        stage.source_task_data_ptr = source.task_data_ptr;
+        stage.source_route_ordinal = source.ordinal;
+        stage.source_route_row = source.row;
+        stage.source_input_fnv = source.input_fnv;
+        stage.source_input_nonzero = source.input_nonzero;
+        stage.source_input_dram = source.input_dram;
+        stage.source_input_len = source.input_len;
+        stage.source_input_dmem = source.input_dmem;
+        stage.source_input_task_data_ptr = source.input_task_data_ptr;
+        stage.source_age = stage.stage_event - source.join_event;
+        return;
+    }
+    for (size_t i = 0; i < g_audio_image_sources.size(); ++i) {
+        const AudioImageSource& source = g_audio_image_sources[i];
+        if (source.phase != stage.phase || source.width != stage.width ||
+            source.origin != stage.origin || source.join_event > stage.stage_event ||
+            source.task_data_ptr != stage.task_data_ptr ||
+            std::strcmp(source.arm ? source.arm : "n/a",
+                        stage.arm ? stage.arm : "n/a") != 0) continue;
+        if (prior < 0 || source.join_event >
+                         g_audio_image_sources[prior].join_event) prior = static_cast<int>(i);
+    }
+    if (prior >= 0) {
+        const AudioImageSource& source = g_audio_image_sources[prior];
+        stage.source_match = 2;
+        stage.source_join_event = source.join_event;
+        stage.source_event = source.source_event;
+        stage.source_task_data_ptr = source.task_data_ptr;
+        stage.source_route_ordinal = source.ordinal;
+        stage.source_route_row = source.row;
+        stage.source_input_fnv = source.input_fnv;
+        stage.source_input_nonzero = source.input_nonzero;
+        stage.source_input_dram = source.input_dram;
+        stage.source_input_len = source.input_len;
+        stage.source_input_dmem = source.input_dmem;
+        stage.source_input_task_data_ptr = source.input_task_data_ptr;
+        stage.source_age = stage.stage_event - source.join_event;
+        return;
+    }
+    prior = -1;
+    for (size_t i = 0; i < g_audio_image_sources.size(); ++i) {
+        const AudioImageSource& source = g_audio_image_sources[i];
+        if (source.phase != stage.phase || source.width != stage.width ||
+            source.origin != stage.origin || source.join_event > stage.stage_event ||
+            std::strcmp(source.arm ? source.arm : "n/a",
+                        stage.arm ? stage.arm : "n/a") != 0) continue;
+        if (prior < 0 || source.join_event >
+                         g_audio_image_sources[prior].join_event) prior = static_cast<int>(i);
+    }
+    if (prior >= 0) {
+        const AudioImageSource& source = g_audio_image_sources[prior];
+        stage.source_match = 3;
+        stage.source_join_event = source.join_event;
+        stage.source_event = source.source_event;
+        stage.source_task_data_ptr = source.task_data_ptr;
+        stage.source_route_ordinal = source.ordinal;
+        stage.source_route_row = source.row;
+        stage.source_input_fnv = source.input_fnv;
+        stage.source_input_nonzero = source.input_nonzero;
+        stage.source_input_dram = source.input_dram;
+        stage.source_input_len = source.input_len;
+        stage.source_input_dmem = source.input_dmem;
+        stage.source_input_task_data_ptr = source.input_task_data_ptr;
+        stage.source_age = stage.stage_event - source.join_event;
+    }
+}
+
+static void audio_image_match_pcm_locked(size_t pcm_index) {
+    const AudioJoinPcm& pcm = g_audio_join_pcm[pcm_index];
+    int best = -1;
+    uint64_t best_distance = UINT64_MAX;
+    for (size_t i = 0; i < g_audio_image_stages.size(); ++i) {
+        AudioImageStage& stage = g_audio_image_stages[i];
+        int& slot = pcm.source ? stage.source_pcm : stage.consumer_pcm;
+        if (slot >= 0 || !audio_image_match(stage, pcm)) continue;
+        const uint64_t distance = pcm.event > stage.stage_event ?
+            pcm.event - stage.stage_event : stage.stage_event - pcm.event;
+        if (distance < best_distance) {
+            best = static_cast<int>(i);
+            best_distance = distance;
+        }
+    }
+    if (best >= 0) {
+        AudioImageStage& stage = g_audio_image_stages[best];
+        if (pcm.source) {
+            stage.source_pcm = static_cast<int>(pcm_index);
+            g_audio_join_pcm[pcm_index].image_source_used = true;
+        } else {
+            stage.consumer_pcm = static_cast<int>(pcm_index);
+            g_audio_join_pcm[pcm_index].image_consumer_used = true;
+        }
+        audio_image_report_locked(stage);
+    } else if (!pcm.source && pcm.nonzero != 0 &&
+               !g_audio_image_stages.empty()) {
+        ++g_audio_image_consumer_only;
+        if (g_audio_image_consumer_only <= 40 ||
+            (g_audio_image_consumer_only % 128) == 0) {
+            fprintf(stderr,
+                    "[audtask-image-consumer-only] event=%" PRIu64
+                    " phase=%u width=%u origin=0x%06X n=%u guest=0x%06X"
+                    " bytes=%u fnv=%08X nz=%u\n",
+                    pcm.event, pcm.phase, pcm.width, pcm.origin, pcm.n,
+                    pcm.rdram & 0x007FFFFFu, pcm.bytes, pcm.fnv,
+                    pcm.nonzero);
+            fflush(stderr);
+        }
+    }
+}
+
+extern "C" void rs64_audio_join_image_stage(const char* arm,
+                                               uint32_t ordinal, uint32_t row,
+                                               uint32_t phase, uint32_t width,
+                                               uint32_t origin, uint32_t stage,
+                                               uint32_t dest, uint32_t len,
+                                               uint32_t fnv, uint32_t nonzero,
+                                               uint32_t dest_valid,
+                                               uint32_t task_data_ptr,
+                                               uint64_t task_generation,
+                                               uint32_t handoff_thread,
+                                               uint32_t event_thread,
+                                               uint64_t latest_generation,
+                                               uint32_t latest_route_seq,
+                                               uint32_t latest_route_ordinal,
+                                               uint32_t latest_route_row) {
+    std::lock_guard<std::mutex> lock(g_audio_join_mutex);
+    audio_image_scope_locked(phase, width, origin);
+    if ((stage != 2 && stage != 3) || len == 0 ||
+        g_audio_image_stages.size() >= 8192) return;
+    AudioImageStage image{};
+    image.arm = arm;
+    image.ordinal = ordinal;
+    image.row = row;
+    image.phase = phase;
+    image.width = width;
+    image.origin = origin;
+    image.stage = stage;
+    image.dest = dest & 0x007FFFFFu;
+    image.len = len;
+    image.fnv = fnv;
+    image.nonzero = nonzero;
+    image.dest_valid = dest_valid != 0;
+    image.task_data_ptr = task_data_ptr;
+    image.task_generation = task_generation;
+    image.handoff_thread = handoff_thread;
+    image.event_thread = event_thread;
+    image.latest_generation = latest_generation;
+    image.latest_route_seq = latest_route_seq;
+    image.latest_route_ordinal = latest_route_ordinal;
+    image.latest_route_row = latest_route_row;
+    image.stage_event = audio_join_next_event();
+    g_audio_image_stages.push_back(image);
+    AudioImageStage& registered = g_audio_image_stages.back();
+    audio_image_match_source_locked(registered);
+    audio_image_match_stage_locked(registered);
+    fprintf(stderr,
+            "[audtask-image-stage-row] arm=%s ordinal=%u row=%u phase=%u"
+            " width=%u origin=0x%06X stage=%u event=%" PRIu64
+            " dest=0x%06X len=0x%X fnv=%08X nz=%u dest_valid=%u"
+            " task_data_ptr=0x%08X task_generation=%" PRIu64
+            " input_fnv=%08X input_nz=%u input_dram=0x%06X input_len=0x%X"
+            " input_dmem=0x%03X input_task_data_ptr=0x%08X"
+            " handoff_thread=%u event_thread=%u latest_generation=%" PRIu64
+            " latest_route_seq=%u latest_route_ordinal=%u latest_route_row=%u\n",
+            arm, ordinal, row, phase, width, origin, stage,
+            registered.stage_event, registered.dest, len, fnv, nonzero,
+            registered.dest_valid ? 1u : 0u, registered.task_data_ptr,
+            registered.task_generation, registered.handoff_thread,
+            registered.source_input_fnv, registered.source_input_nonzero,
+            registered.source_input_dram, registered.source_input_len,
+            registered.source_input_dmem,
+            registered.source_input_task_data_ptr,
+            registered.event_thread, registered.latest_generation,
+            registered.latest_route_seq, registered.latest_route_ordinal,
+            registered.latest_route_row);
+    fflush(stderr);
+}
+
+extern "C" void rs64_m5_audio_join_snapshot(
+    const char* arm, uint32_t ordinal, uint32_t row, uint32_t phase,
+    uint32_t width, uint32_t origin, uint64_t* task_generation,
+    uint64_t* source_match_event, uint64_t* consumer_match_event,
+    uint64_t* stage_event) {
+    if (task_generation) *task_generation = 0;
+    if (source_match_event) *source_match_event = 0;
+    if (consumer_match_event) *consumer_match_event = 0;
+    if (stage_event) *stage_event = 0;
+    std::lock_guard<std::mutex> lock(g_audio_join_mutex);
+    for (auto it = g_audio_image_stages.rbegin();
+         it != g_audio_image_stages.rend(); ++it) {
+        const AudioImageStage& image = *it;
+        if (image.ordinal != ordinal || image.row != row ||
+            image.phase != phase || image.width != width ||
+            image.origin != origin ||
+            std::strcmp(image.arm ? image.arm : "n/a", arm ? arm : "n/a") != 0) {
+            continue;
+        }
+        if (task_generation) *task_generation = image.task_generation;
+        if (stage_event) *stage_event = image.stage_event;
+        if (image.source_pcm >= 0 &&
+            static_cast<size_t>(image.source_pcm) < g_audio_join_pcm.size() &&
+            source_match_event) {
+            *source_match_event = g_audio_join_pcm[image.source_pcm].event;
+        }
+        if (image.consumer_pcm >= 0 &&
+            static_cast<size_t>(image.consumer_pcm) < g_audio_join_pcm.size() &&
+            consumer_match_event) {
+            *consumer_match_event = g_audio_join_pcm[image.consumer_pcm].event;
+        }
+        return;
+    }
+}
+
+extern "C" void rs64_audio_join_image_source(
+    const char* arm, uint32_t ordinal, uint32_t row, uint32_t phase,
+    uint32_t width, uint32_t origin, uint64_t source_event,
+    uint32_t task_data_ptr, uint32_t dram, uint32_t len, uint32_t fnv,
+    uint32_t nonzero, uint64_t task_generation, uint32_t handoff_thread,
+    uint32_t event_thread, uint32_t input_fnv, uint32_t input_nonzero,
+    uint32_t input_dram, uint32_t input_len, uint32_t input_dmem,
+    uint32_t input_task_data_ptr) {
+    std::lock_guard<std::mutex> lock(g_audio_join_mutex);
+    audio_image_scope_locked(phase, width, origin);
+    if (len == 0 || g_audio_image_sources.size() >= 8192) return;
+    AudioImageSource source{arm, ordinal, row, phase, width, origin,
+                            audio_join_next_event(), source_event,
+                            task_data_ptr, task_generation, handoff_thread,
+                            event_thread, dram & 0x007FFFFFu, len, fnv, nonzero};
+    source.input_fnv = input_fnv;
+    source.input_nonzero = input_nonzero;
+    source.input_dram = input_dram;
+    source.input_len = input_len;
+    source.input_dmem = input_dmem;
+    source.input_task_data_ptr = input_task_data_ptr;
+    g_audio_image_sources.push_back(source);
+    if ((g_audio_image_sources.size() & 0xFFu) == 0) {
+        audio_image_source_census_locked(phase, width, origin);
+    }
+    for (AudioImageStage& stage : g_audio_image_stages) {
+        if (stage.source_match == 0 && stage.phase == phase &&
+            stage.width == width && stage.origin == origin &&
+            stage.task_data_ptr == task_data_ptr &&
+            std::strcmp(stage.arm ? stage.arm : "n/a", arm ? arm : "n/a") == 0) {
+            audio_image_match_source_locked(stage);
+        }
+    }
+}
+
+extern "C" void rs64_audio_join_image_dma(
+    const char* arm, uint32_t ordinal, uint32_t row, uint32_t phase,
+    uint32_t width, uint32_t origin, uint64_t dma_event, uint32_t dram,
+    uint32_t len, uint32_t fnv, uint32_t nonzero,
+    uint32_t source_dmem_fnv, uint32_t source_dmem_nonzero,
+    uint64_t source_event, uint64_t task_generation,
+    uint32_t latest_route_seq, uint32_t latest_route_ordinal,
+    uint32_t latest_route_row) {
+    std::lock_guard<std::mutex> lock(g_audio_join_mutex);
+    audio_image_scope_locked(phase, width, origin);
+    int best = -1;
+    for (size_t i = 0; i < g_audio_image_stages.size(); ++i) {
+        AudioImageStage& stage = g_audio_image_stages[i];
+        if (stage.dma_event != 0 || stage.ordinal != ordinal ||
+            stage.row != row || stage.phase != phase || stage.width != width ||
+            stage.origin != origin || std::strcmp(stage.arm, arm) != 0 ||
+            stage.dest != (dram & 0x007FFFFFu) || stage.len != len) continue;
+        best = static_cast<int>(i);
+        break;
+    }
+    if (best < 0) return;
+    AudioImageStage& stage = g_audio_image_stages[best];
+    stage.dma_event = dma_event;
+    stage.dma_dram = dram & 0x007FFFFFu;
+    stage.dma_len = len;
+    stage.dma_fnv = fnv;
+    stage.dma_nonzero = nonzero;
+    stage.source_dmem_fnv = source_dmem_fnv;
+    stage.source_dmem_nonzero = source_dmem_nonzero;
+    audio_image_match_stage_locked(stage);
+    fprintf(stderr,
+            "[audtask-image-dma-join] arm=%s ordinal=%u row=%u phase=%u"
+            " width=%u origin=0x%06X dma_event=%" PRIu64
+            " dram=0x%06X len=0x%X fnv=%08X nz=%u stage=%u"
+            " stage_event=%" PRIu64 " source_dmem_fnv=%08X source_dmem_nz=%u"
+            " source_event=%" PRIu64 " task_generation=%" PRIu64
+            " latest_route_seq=%u latest_route_ordinal=%u latest_route_row=%u"
+            " post_transform_fnv=%08X post_transform_nz=%u"
+            " destination_fnv=%08X destination_nz=%u\n",
+            arm ? arm : "n/a", ordinal, row, phase, width, origin, dma_event,
+            stage.dma_dram, len, fnv, nonzero, stage.stage,
+            stage.stage_event, stage.source_dmem_fnv, stage.source_dmem_nonzero,
+            source_event, task_generation, latest_route_seq,
+            latest_route_ordinal, latest_route_row,
+            stage.fnv, stage.nonzero, fnv, nonzero);
+    fflush(stderr);
+}
