+    ViParitySchedulerTrace& trace = vi_parity_scheduler_trace;
+    if (trace.all_width_prefix_rows < 8) {
+        const uint32_t prefix = trace.all_width_prefix_rows++;
+        std::fprintf(stderr,
+            "[vi-parity-scheduler-control] arm=%s prefix=%u callback=%" PRIu64
+            " total_vis=%" PRIu64 " delta=%" PRIu64 " width=%u\n",
+            vi_context_port_arm(), prefix, callback_ordinal, current_total_vis,
+            delta_total_vis, width);
+        std::fflush(stderr);
+    }
+
+    if (width != 640) return;
+    if (trace.rows >= 512) {
+        trace.overflow++;
+        return;
+    }
+
+    const uint32_t row = trace.rows++;
+    const size_t bucket = vi_context_port_origin_bucket(committed_origin);
+    if (selected_field < 2) trace.origin_field[bucket][selected_field]++;
+    if (delta_total_vis > 1) trace.skipped++;
+    if (delta_total_vis > trace.max_delta) trace.max_delta = delta_total_vis;
+
+    std::fprintf(stderr,
+        "[vi-parity-scheduler] arm=%s row=%u callback=%" PRIu64
