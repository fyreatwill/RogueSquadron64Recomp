+                " dma_fnv=%08X dma_nz=%u"
+                " source_event=%" PRIu64 " source_n=%u source_samples=%u"
+                " source_bytes=%u source_fnv=%08X source_nz=%u"
+                " consumer_event=%" PRIu64 " consumer_n=%u"
+                " consumer_samples=%u consumer_bytes=%u consumer_fnv=%08X"
+                " consumer_nz=%u\n",
+                task.n, i, joined.range.event, joined.range.dmem,
+                joined.range.dram, joined.range.len, joined.range.payload_fnv,
+                joined.range.payload_nz, source ? source->event : 0,
+                source ? source->n : 0, source ? source->samples : 0,
+                source ? source->bytes : 0, source ? source->fnv : 0,
+                source ? source->nonzero : 0, consumer ? consumer->event : 0,
+                consumer ? consumer->n : 0, consumer ? consumer->samples : 0,
+                consumer ? consumer->bytes : 0, consumer ? consumer->fnv : 0,
+                consumer ? consumer->nonzero : 0);
