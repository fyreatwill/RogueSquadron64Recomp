+            const uint32_t origin = rs64_vi_committed_origin();
+            const bool phase_allowed =
+                (width == 1024u && origin == 0x00790400u) ||
+                (width == 512u && origin == 0x006AB400u);
+            static uint32_t s_phase_key = 0xFFFFFFFFu;
+            static uint32_t s_phase_n = 0;
+            if (phase_allowed) {
+                const uint32_t phase_key = (width << 24) ^ origin;
+                if (phase_key != s_phase_key) {
+                    s_phase_key = phase_key;
+                    s_phase_n = 0;
+                }
+                const uint32_t n = s_phase_n++;
+                const uint32_t full_byte_count = sample_count * sizeof(int16_t);
+                const uint8_t* p = reinterpret_cast<const uint8_t*>(
+                    TO_PTR(int16_t, audio_data_));
+                uint32_t fnv = 2166136261u;
+                uint32_t nonzero = 0;
+                for (uint32_t i = 0; i < full_byte_count; i++) {
+                    fnv = (fnv * 16777619u) ^ p[i];
+                    nonzero += p[i] != 0;
+                }
+                uint32_t ordinal = 0xFFFFFFFFu;
+                uint32_t row = 0xFFFFFFFFu;
+                rs64_audio_current_route_snapshot(nullptr, nullptr, nullptr,
+                                                  &ordinal, &row, nullptr, nullptr);
+                rs64_audio_join_pcm("source", rs64_phase_ord(), width, origin,
+                                    ordinal, row, n,
+                                    static_cast<uint32_t>(audio_data_),
+                                    sample_count, full_byte_count, fnv, nonzero);
+                if (n < 40 || (n % 128) == 0) {
+                    std::fprintf(stderr,
+                        "[pcm-boundary-source] n=%u phase=%u width=%u origin=0x%06X"
+                        " rdram=0x%08X samples=%u bytes=%u fnv=0x%08X nz=%u\n",
+                        n, rs64_phase_ord(), width, origin,
+                        static_cast<uint32_t>(audio_data_), sample_count, full_byte_count,
+                        fnv, nonzero);
+                    std::fflush(stderr);
+                }
+            }
+        }
+        audio_callbacks.queue_samples(TO_PTR(int16_t, audio_data_), sample_count,
+                                      static_cast<uint32_t>(audio_data_));
     }
 }
 
