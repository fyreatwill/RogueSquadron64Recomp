+    if (h != s->hash) {
+        s->changes++; ph_changes++; s->hash = h;
+        if (s->changes <= 3) std::fprintf(stderr, "[s4211-chg] phase=%u dp=0x%06X change#%llu at task#%llu\n", phase, dp, (unsigned long long)s->changes, (unsigned long long)s->tasks);
