+    // the null result is real, not an artifact of this phase never reaching
+    // any indirect-call code path.
+    constexpr int32_t k_musyx_synth_frame = 0x8009123C;
+    if (addr == k_musyx_synth_frame) {
+        static const bool enabled = []{
+            const char* e = std::getenv("ROGUESQ_LOG_TICKFUNC_CALLER");
+            return e && *e && *e != '0';
+        }();
+        if (enabled) {
+            static int n = 0;
+            if (n < 40 || (n % 128) == 0) {
+                fprintf(stderr, "[tickfunc-caller-control] musyxSynthFrame resolved phase=%u n=%d\n", rs64_phase_ord(), n);
+            }
+            n++;
+        }
+        return;
+    }
+    if (addr != k_tick_all_active_songs && addr != k_tick_audio_sequencer_frame) {
+        return;
+    }
+    static const bool enabled = []{
+        const char* e = std::getenv("ROGUESQ_LOG_TICKFUNC_CALLER");
+        return e && *e && *e != '0';
+    }();
+    if (!enabled) {
+        return;
+    }
+    void* frames[8];
+    int n = backtrace(frames, 8);
+    fprintf(stderr, "[tickfunc-caller] resolved 0x%08X, native backtrace (%d frames):\n", addr, n);
+    backtrace_symbols_fd(frames, n, fileno(stderr));
+    fflush(stderr);
+}
+
+static void rs64_log_service_resolution(int32_t addr, recomp_func_t* func) {
+    constexpr int32_t k_service_voice_pool_frame = 0x8009B5A8;
+    if (addr != k_service_voice_pool_frame || rs64_phase_ord() < 4) {
+        return;
+    }
+    static const bool enabled = []{
+        const char* all = std::getenv("ROGUESQ_LOG_ALL");
+        const char* specific = std::getenv("ROGUESQ_LOG_SERVICE_RESOLVE");
+        return (all && *all && *all != '0') || (specific && *specific && *specific != '0');
+    }();
+    if (!enabled) {
+        return;
+    }
+    static std::atomic<uint32_t> n{0};
+    const uint32_t call = n.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (call <= 20 || (call % 100) == 0) {
+        fprintf(stderr, "[svc-resolve] n=%u phase=%u guest=0x%08X host=%p expected=%p match=%d\n",
+                call, rs64_phase_ord(), static_cast<uint32_t>(addr),
+                reinterpret_cast<void*>(func), reinterpret_cast<void*>(&serviceVoicePoolFrame),
+                func == &serviceVoicePoolFrame ? 1 : 0);
+        fflush(stderr);
+    }
+}
+
+static void rs64_log_a1_missing_function(int32_t addr) {
+    static const bool enabled = []{
+        const char* e = std::getenv("ROGUESQ_LOG_A1_ABORT");
+        return e && *e && *e != '0';
+    }();
+    if (!enabled) {
+        return;
+    }
+    static unsigned ordinal = 0;
+    const unsigned n = ++ordinal;
+    if (n > 16) {
+        return;
+    }
+    fprintf(stderr, "[a1-abort] ordinal=%u phase=%u requested=0x%08X loaded_count=%zu\n",
+        n, rs64_phase_ord(), static_cast<uint32_t>(addr), loaded_sections.size());
+    for (const LoadedSection& loaded : loaded_sections) {
+        const SectionTableEntry& section = sections_info.code_sections[loaded.section_table_index];
+        const uint32_t lo = static_cast<uint32_t>(loaded.loaded_ram_addr);
+        const uint32_t hi = lo + section.size;
+        fprintf(stderr,
+            "[a1-resident] ordinal=%u section=%zu rom=0x%08X size=0x%X ram=0x%08X range=0x%08X..0x%08X contains=%d\n",
+            n, loaded.section_table_index, section.rom_addr, section.size, lo, lo, hi,
+            static_cast<uint32_t>(addr) >= lo && static_cast<uint32_t>(addr) < hi ? 1 : 0);
+    }
+    fflush(stderr);
+}
+
+static void rs64_log_first_null_resolver(int32_t addr) {
+    if (addr != 0) {
+        return;
+    }
+    static const bool enabled = []{
+        const char* all = std::getenv("ROGUESQ_LOG_ALL");
+        const char* specific = std::getenv("ROGUESQ_LOG_M5_SECOND_EXEC");
+        return (all && *all && *all != '0') ||
+               (specific && *specific && *specific != '0');
+    }();
+    if (!enabled) {
+        return;
+    }
+    static std::atomic<bool> captured{false};
+    bool expected = false;
+    if (!captured.compare_exchange_strong(expected, true, std::memory_order_relaxed)) {
+        return;
+    }
+    void* frames[16];
+    int n = backtrace(frames, 16);
+    void* caller = __builtin_return_address(0);
+    fprintf(stderr,
+            "[m5-null-resolver] requested=0x%08X guest=0x%08X native_caller=%p backtrace_frames=%d\n",
+            static_cast<uint32_t>(addr), static_cast<uint32_t>(g_rs64_last_guest_pc),
+            caller, n);
+    backtrace_symbols_fd(frames, n, fileno(stderr));
+    fflush(stderr);
+}
+
+static void rs64_log_m5_pretarget_resolver(int32_t addr) {
+    static const bool enabled = []{
+        const char* e = std::getenv("ROGUESQ_LOG_M5_PRETARGET");
+        return e && *e && *e != '0';
+    }();
+    if (!enabled || rs64_phase_ord() < 4) {
+        return;
+    }
+    static uint32_t bucket = 0xFFFFFFFFu;
+    static uint32_t rows = 0;
+    const uint32_t phase = rs64_phase_ord();
+    if (phase != bucket) {
+        bucket = phase;
+        rows = 0;
+    }
+    const bool priority = addr == 0 || static_cast<uint32_t>(addr) == 0x8009123Cu;
+    if (rows >= 64u && !priority) {
+        return;
+    }
+    void* frames[4]{};
+    const int depth = backtrace(frames, 4);
+    fprintf(stderr,
+        "[m5-pretarget] n=%u phase=%u requested=0x%08X guest=0x%08X "
+        "native_frame_1=%p native_frame_2=%p depth=%d priority=%u\n",
+        rows, phase, static_cast<uint32_t>(addr),
+        static_cast<uint32_t>(g_rs64_last_guest_pc),
+        depth > 2 ? frames[2] : nullptr,
+        depth > 3 ? frames[3] : nullptr, depth, priority ? 1u : 0u);
+    fflush(stderr);
+    if (!priority) {
+        ++rows;
+    }
+}
+
+// ROGUESQ s7520 class FQ: executed code bytes vs the recompiled image. A static recompile runs the code the ROM held at
+// regen time; a VR4300 runs whatever bytes sit in RAM. ROGUESQ_S7520_CODEWATCH=1 compares, at every osViSwapBuffer, every
+// osInvalICache and every overlay registration, the RAM words of every recompiled function (FuncEntry offset/rom_size) of
+// the resident main sections and of each overlay section at 0x800A5130 with the ROM words N64Recomp compiled; logs state
+// transitions ([s7520] kind=...), checks every get_function into the overlay window against the section registered last
+// (stale func_map entries / bytes not resident), flags PI DMAs into main code, prints [s7520-sum] every 300 swaps.
+// Ctl ROGUESQ_S7520_CTL=1: swap 600 flips one byte of a main function (restored at swap 660); after swap 900 the first
+// get_function into the overlay window flips a byte inside that function (restored once the row prints).
+namespace {
+struct S7520 {
+    bool on = false, init = false;
+    std::vector<size_t> main_idx, ovl_idx;
+    std::vector<std::unordered_map<uint32_t, recomp_func_t*>> offmap;  // per code section index
+    std::unordered_map<recomp_func_t*, int> patchset;
+    int reg_ovl = -1;                 // code section index registered last at the overlay window
+    uint32_t ovl_lo = 0, ovl_hi = 0;  // window
+    int last_main_bad = -1, last_ovl_state = -99, swaps = 0;
+    unsigned long checks = 0, main_bad_checks = 0, ovl_ok = 0, ovl_partial = 0, ovl_other = 0, ovl_none = 0, ovl_unreg = 0;
+    unsigned long gf_ovl = 0, gf_stale = 0, gf_funcdiff = 0, exec_checks = 0, exec_diff = 0, dma_main = 0, iinv = 0, iinv_bad = 0;
+    bool dirty = true;
+    int ctl = 0; bool ctl_main_on = false; uint32_t ctl_main_addr = 0; int ctl_ovl_state = 0; uint32_t ctl_ovl_addr = 0;
+    uint8_t* rdram = nullptr;
+    std::vector<std::map<uint32_t, std::pair<uint32_t, uint32_t>>> prevbad;  // per code section idx
+    long wlines = 0;
+};
+S7520 s7;
+std::mutex s7m;
+inline uint32_t s7_be32(const uint8_t* p) { return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3]; }
+inline uint32_t s7_ramw(uint8_t* rdram, uint32_t va) { return *reinterpret_cast<uint32_t*>(rdram + (va - 0x80000000u)); }
+void s7_init() {
+    if (s7.init) return;
+    s7.init = true;
+    const char* e = std::getenv("ROGUESQ_S7520_CODEWATCH");
+    s7.on = e && e[0] && e[0] != '0';
+    if (!s7.on) return;
+    const char* c = std::getenv("ROGUESQ_S7520_CTL"); s7.ctl = c ? std::atoi(c) : 0;
+    s7.offmap.resize(sections_info.num_code_sections);
+    s7.prevbad.resize(sections_info.num_code_sections);
+    std::unordered_map<uint32_t, int> ramcount;
+    for (size_t i = 0; i < sections_info.num_code_sections; i++) ramcount[sections_info.code_sections[i].ram_addr]++;
+    for (size_t i = 0; i < sections_info.num_code_sections; i++) {
+        const auto& s = sections_info.code_sections[i];
+        for (size_t f = 0; f < s.num_funcs; f++) s7.offmap[i][s.funcs[f].offset] = s.funcs[f].func;
+        if (ramcount[s.ram_addr] > 1) { s7.ovl_idx.push_back(i); s7.ovl_lo = s.ram_addr;
+            if (s.ram_addr + s.size > s7.ovl_hi) s7.ovl_hi = s.ram_addr + s.size; }
+        else s7.main_idx.push_back(i);
+        std::fprintf(stderr, "[s7520-sec] idx=%zu index=%zu rom=%08X ram=%08X size=%X funcs=%zu %s\n", i, s.index, s.rom_addr, s.ram_addr,
+                     s.size, s.num_funcs, ramcount[s.ram_addr] > 1 ? "ovl" : "main");
+    }
+    for (size_t i = 0; i < num_patch_code_sections; i++)
+        for (size_t f = 0; f < patch_code_sections[i].num_funcs; f++) s7.patchset[patch_code_sections[i].funcs[f].func] = 1;
+    std::fprintf(stderr, "[s7520-init] main=%zu ovl=%zu window=%08X-%08X patchfuncs=%zu ctl=%d\n", s7.main_idx.size(), s7.ovl_idx.size(),
+                 s7.ovl_lo, s7.ovl_hi, s7.patchset.size(), s7.ctl);
+}
+// mismatching code words of section i (as loaded at its ram_addr); first mismatch reported via out params
+unsigned long s7_section_diff(uint8_t* rdram, size_t i, uint32_t* first_va, uint32_t* ramw, uint32_t* romw, unsigned long* words,
+                              std::map<uint32_t, std::pair<uint32_t, uint32_t>>* out = nullptr) {
+    const auto& s = sections_info.code_sections[i];
+    auto rom = recomp::get_rom();
+    unsigned long bad = 0, n = 0;
+    for (size_t f = 0; f < s.num_funcs; f++) {
+        uint32_t off = s.funcs[f].offset, sz = s.funcs[f].rom_size;
+        if ((uint64_t)s.rom_addr + off + sz > rom.size()) continue;
+        for (uint32_t o = off; o + 4 <= off + sz; o += 4) {
+            ++n;
+            uint32_t a = s7_ramw(rdram, s.ram_addr + o), b = s7_be32(rom.data() + s.rom_addr + o);
+            if (a != b) { if (!bad && first_va) { *first_va = s.ram_addr + o; *ramw = a; *romw = b; } ++bad;
+                          if (out) (*out)[s.ram_addr + o] = {a, b}; }
+        }
+    }
+    if (words) *words = n;
+    return bad;
+}
+// print +/- changes of a section's differing-word set (s7520 v2), budgeted
+void s7_emit(size_t i, const std::map<uint32_t, std::pair<uint32_t, uint32_t>>& now, const char* why, int ctl) {
+    auto& prev = s7.prevbad[i];
+    for (auto& [va, v] : now) if (!prev.count(va) && s7.wlines++ < 6000)
+        std::fprintf(stderr, "[s7520-w] sec=%zu op=+ va=%08X ram=%08X rom=%08X why=%s swap=%d ctl=%d\n", i, va, v.first, v.second, why, s7.swaps, ctl);
+    for (auto& [va, v] : prev) if (!now.count(va) && s7.wlines++ < 6000)
+        std::fprintf(stderr, "[s7520-w] sec=%zu op=- va=%08X why=%s swap=%d ctl=%d\n", i, va, why, s7.swaps, ctl);
+    prev = now;
+}
+void s7_sum(const char* why) {
+    std::fprintf(stderr, "[s7520-sum] why=%s swaps=%d checks=%lu main_bad_checks=%lu ovl_ok=%lu ovl_partial=%lu ovl_other=%lu ovl_none=%lu "
+                 "ovl_unreg=%lu gf_ovl=%lu gf_stale=%lu gf_funcdiff=%lu exec_checks=%lu exec_diff=%lu dma_main=%lu iinv=%lu iinv_bad=%lu reg=%d\n",
+                 why, s7.swaps, s7.checks, s7.main_bad_checks, s7.ovl_ok, s7.ovl_partial, s7.ovl_other, s7.ovl_none, s7.ovl_unreg,
+                 s7.gf_ovl, s7.gf_stale, s7.gf_funcdiff, s7.exec_checks, s7.exec_diff, s7.dma_main, s7.iinv, s7.iinv_bad, s7.reg_ovl);
+    std::fflush(stderr);
+}
+// returns overlay state: 0 ok, 1 partial (registered section mismatches but no other matches), 2 other section resident, 3 none, 4 unregistered
+int s7_check(uint8_t* rdram, const char* why, bool force_log) {
+    ++s7.checks;
+    uint32_t fva = 0, rw = 0, ow = 0; unsigned long words = 0, mbad = 0;
+    for (size_t i : s7.main_idx) { uint32_t a = 0, b = 0, c = 0; unsigned long w = 0;
+        std::map<uint32_t, std::pair<uint32_t, uint32_t>> bm;
+        unsigned long d = s7_section_diff(rdram, i, &a, &b, &c, &w, &bm); words += w;
+        s7_emit(i, bm, why, s7.ctl_main_on ? 1 : 0);
+        if (d && !mbad) { fva = a; rw = b; ow = c; } mbad += d; }
+    if (mbad) ++s7.main_bad_checks;
+    if ((int)(mbad != 0) != s7.last_main_bad || (force_log && mbad)) {
+        std::fprintf(stderr, "[s7520] kind=main why=%s swap=%d bad_words=%lu of=%lu first=%08X ram=%08X rom=%08X ctl=%d\n", why, s7.swaps,
+                     mbad, words, fva, rw, ow, s7.ctl_main_on ? 1 : 0);
+        s7.last_main_bad = mbad != 0;
+    }
+    int st; unsigned long regbad = 0, regwords = 0; int match = -1;
+    uint32_t ofva = 0, orw = 0, oow = 0;
+    for (size_t i : s7.ovl_idx) {
+        uint32_t a = 0, b = 0, c = 0; unsigned long w = 0;
+        std::map<uint32_t, std::pair<uint32_t, uint32_t>> bm;
+        unsigned long d = s7_section_diff(rdram, i, &a, &b, &c, &w, (int)i == s7.reg_ovl ? &bm : nullptr);
+        if ((int)i == s7.reg_ovl) { regbad = d; regwords = w; ofva = a; orw = b; oow = c; s7_emit(i, bm, why, 0); }
+        if (!d && match < 0) match = (int)i;
+    }
+    if (s7.reg_ovl < 0) st = 4;
+    else if (!regbad) st = 0;
+    else if (match >= 0) st = 2;
+    else st = 1;
+    if (st == 1 && regbad * 2 > regwords) st = 3;
+    switch (st) { case 0: ++s7.ovl_ok; break; case 1: ++s7.ovl_partial; break; case 2: ++s7.ovl_other; break; case 3: ++s7.ovl_none; break; default: ++s7.ovl_unreg; }
+    if (st != s7.last_ovl_state || force_log) {
+        std::fprintf(stderr, "[s7520] kind=ovl why=%s swap=%d state=%d reg=%d resident_match=%d reg_bad=%lu of=%lu first=%08X ram=%08X rom=%08X ctl=%d\n",
+                     why, s7.swaps, st, s7.reg_ovl, match, regbad, regwords, ofva, orw, oow, s7.ctl_ovl_state == 1 ? 1 : 0);
+        s7.last_ovl_state = st;
+    }
+    s7.dirty = (mbad != 0) || st != 0;
+    return st;
+}
+}  // namespace
+
+extern "C" void rs64_s7520_swap(uint8_t* rdram) {
+    s7_init(); if (!s7.on) return;
+    std::lock_guard<std::mutex> lk(s7m);
+    s7.rdram = rdram;
+    ++s7.swaps;
+    if (s7.ctl && s7.swaps == 600 && !s7.main_idx.empty()) {
+        const auto& s = sections_info.code_sections[s7.main_idx.back()];
+        const auto& f = s.funcs[s.num_funcs / 2];
+        s7.ctl_main_addr = s.ram_addr + f.offset + 4;
+        rdram[(s7.ctl_main_addr ^ 3) - 0x80000000u] ^= 0x01;  // MEM_B layout
+        s7.ctl_main_on = true;
+        std::fprintf(stderr, "[s7520-ctl] main flip at %08X swap=%d\n", s7.ctl_main_addr, s7.swaps);
+    }
+    if (s7.ctl_main_on && s7.swaps == 660) {
+        rdram[(s7.ctl_main_addr ^ 3) - 0x80000000u] ^= 0x01;
+        std::fprintf(stderr, "[s7520-ctl] main restore at %08X swap=%d\n", s7.ctl_main_addr, s7.swaps);
+        s7_check(rdram, "ctlrestore", false);
+        s7.ctl_main_on = false;
+    }
+    s7_check(rdram, "swap", false);
+    if (s7.swaps % 300 == 0) s7_sum("periodic");
+}
+extern "C" void rs64_s7520_iinv(uint8_t* rdram, uint32_t a, uint32_t n, uint32_t ra) {
+    s7_init(); if (!s7.on) return;
+    std::lock_guard<std::mutex> lk(s7m);
+    s7.rdram = rdram;
+    ++s7.iinv;
+    std::fprintf(stderr, "[s7520-iinv] a=%08X n=%X ra=%08X swap=%d\n", a, n, ra, s7.swaps);
+    int st = s7_check(rdram, "iinv", true);
+    for (size_t i = 0; i < s7.prevbad.size(); i++) {
+        if (std::find(s7.main_idx.begin(), s7.main_idx.end(), i) == s7.main_idx.end() && (int)i != s7.reg_ovl) continue;
+        int k = 0;
+        for (auto& [va, v] : s7.prevbad[i]) if (k++ < 64)
+            std::fprintf(stderr, "[s7520-iw] sec=%zu va=%08X ram=%08X rom=%08X swap=%d\n", i, va, v.first, v.second, s7.swaps);
+    }
+    if (st != 0) ++s7.iinv_bad;
+}
+extern "C" void rs64_s7520_dma(uint8_t* rdram, uint32_t ram, uint32_t size, uint32_t rom_off) {
+    s7_init(); if (!s7.on) return;
+    std::lock_guard<std::mutex> lk(s7m);
+    s7.rdram = rdram;
+    uint32_t lo = ram | 0x80000000u, hi = lo + size;
+    if (hi > s7.ovl_lo && lo < s7.ovl_hi) {
+        s7.dirty = true;
+        static int nshown = 0;
+        // expected ROM offset if this DMA carries some overlay section's own bytes at its link address
+        int self = -1;
+        for (size_t i : s7.ovl_idx) { const auto& s = sections_info.code_sections[i];
+            if (rom_off == s.rom_addr + (lo - s.ram_addr)) { self = (int)i; break; } }
+        if (nshown++ < 400) std::fprintf(stderr, "[s7520-odma] ram=%08X size=%X rom=%08X self_section=%d reg=%d swap=%d\n", lo, size, rom_off, self, s7.reg_ovl, s7.swaps);
+    }
+    for (size_t i : s7.main_idx) {
+        const auto& s = sections_info.code_sections[i];
+        if (!(hi > s.ram_addr && lo < s.ram_addr + s.size)) continue;
+        for (size_t f = 0; f < s.num_funcs; f++) {
+            uint32_t fa = s.ram_addr + s.funcs[f].offset, fb = fa + s.funcs[f].rom_size;
+            if (hi > fa && lo < fb) {
+                ++s7.dma_main;
+                bool same = (uint64_t)rom_off + (fa - lo) < recomp::get_rom().size() && rom_off == s.rom_addr + (lo - s.ram_addr);
+                std::fprintf(stderr, "[s7520] kind=dma_main ram=%08X size=%X rom=%08X func=%08X self_image=%d swap=%d\n", lo, size, rom_off, fa,
+                             same ? 1 : 0, s7.swaps);
+                break;
+            }
+        }
+    }
+}
+static void rs64_s7520_note_load(size_t idx, int32_t ram) {
+    s7_init(); if (!s7.on) return;
+    std::lock_guard<std::mutex> lk(s7m);
+    if (std::find(s7.ovl_idx.begin(), s7.ovl_idx.end(), idx) == s7.ovl_idx.end()) return;
+    std::fprintf(stderr, "[s7520-load] idx=%zu ram=%08X prev=%d swap=%d\n", idx, (uint32_t)ram, s7.reg_ovl, s7.swaps);
+    s7.reg_ovl = (int)idx;
+    s7.dirty = true;
+    s7.prevbad[idx].clear();
+    if (s7.wlines < 6000) std::fprintf(stderr, "[s7520-w] sec=%zu op=reset swap=%d\n", idx, s7.swaps);
+    s7.last_ovl_state = -99;  // log the next state
+}
+static void rs64_s7520_note_load_fwd(size_t idx, int32_t ram) { rs64_s7520_note_load(idx, ram); }
+static void rs64_s7520_gf(int32_t addr, recomp_func_t* got) {
+    if (!s7.init) s7_init();
+    if (!s7.on) return;
+    uint32_t a = (uint32_t)addr;
+    if (a < s7.ovl_lo || a >= s7.ovl_hi) return;
+    std::lock_guard<std::mutex> lk(s7m);
+    ++s7.gf_ovl;
+    uint8_t* rdram = s7.rdram;
+    if (s7.reg_ovl < 0) return;
+    const auto& s = sections_info.code_sections[s7.reg_ovl];
+    auto it = s7.offmap[s7.reg_ovl].find(a - s.ram_addr);
+    bool patch = s7.patchset.count(got) != 0;
+    if (it == s7.offmap[s7.reg_ovl].end()) {
+        ++s7.gf_stale;
+        if (s7.gf_stale <= 64) std::fprintf(stderr, "[s7520] kind=gf_stale addr=%08X reg=%d patch=%d swap=%d\n", a, s7.reg_ovl, patch ? 1 : 0, s7.swaps);
+        return;
+    }
