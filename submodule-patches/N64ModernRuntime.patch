+static void audio_join_report_locked(AudioJoinTask& task) {
+    size_t sources = 0;
+    size_t consumers = 0;
+    bool complete = false;
+    bool dma_before_source = true;
+    bool source_before_consumer = true;
+    bool source_after_task = true;
+    bool consumer_after_task = true;
+    for (const AudioJoinRange& joined : task.ranges) {
+        if (joined.source_pcm >= 0) {
+            const AudioJoinPcm& source = g_audio_join_pcm[joined.source_pcm];
+            ++sources;
+            dma_before_source &= joined.range.event < source.event;
+            source_after_task &= task.end_event < source.event;
+        }
+        if (joined.consumer_pcm >= 0) {
+            const AudioJoinPcm& consumer = g_audio_join_pcm[joined.consumer_pcm];
+            ++consumers;
+            dma_before_source &= joined.range.event < consumer.event;
+            consumer_after_task &= task.end_event < consumer.event;
+        }
+        if (joined.source_pcm >= 0 && joined.consumer_pcm >= 0) {
+            const AudioJoinPcm& source = g_audio_join_pcm[joined.source_pcm];
+            const AudioJoinPcm& consumer = g_audio_join_pcm[joined.consumer_pcm];
+            complete = true;
+            source_before_consumer &= source.event < consumer.event;
+        }
+    }
+    if (task.reported && sources == task.reported_sources &&
+        consumers == task.reported_consumers) {
+        return;
+    }
+    task.reported_sources = sources;
+    task.reported_consumers = consumers;
+    task.reported = true;
+    fprintf(stderr,
+            "[audtask-join] n=%u phase=%u width=%u origin=0x%06X"
+            " begin=%" PRIu64 " end=%" PRIu64 " dma_count=%zu"
+            " source_matches=%zu consumer_matches=%zu complete=%d"
+            " dma_before_pcm=%d source_before_consumer=%d"
+            " pcm_after_task=%d consumer_after_task=%d"
+            " dmem_changed=%u canary_arm=%s source_fnv=%08X source_nz=%u"
+            " canary_ok=%d break_pc=0x%04X exit=%d\n",
+            task.n, task.phase, task.width, task.origin, task.begin_event,
+            task.end_event, task.ranges.size(), sources, consumers,
+            complete ? 1 : 0, dma_before_source ? 1 : 0,
+            source_before_consumer ? 1 : 0, source_after_task ? 1 : 0,
+            consumer_after_task ? 1 : 0, task.dmem_changed, task.canary_arm,
+            task.source_fnv, task.source_nz,
+            task.canary_ok ? 1 : 0, task.break_pc, task.exit);
+    for (size_t i = 0; i < task.ranges.size(); ++i) {
+        const AudioJoinRange& joined = task.ranges[i];
+        if (joined.source_pcm < 0 && joined.consumer_pcm < 0) continue;
+        const AudioJoinPcm* source = joined.source_pcm >= 0 ?
+            &g_audio_join_pcm[joined.source_pcm] : nullptr;
+        const AudioJoinPcm* consumer = joined.consumer_pcm >= 0 ?
+            &g_audio_join_pcm[joined.consumer_pcm] : nullptr;
+        fprintf(stderr,
+                "[audtask-join-range] task=%u i=%zu direction=dmem_to_rdram"
+                " dma_event=%" PRIu64 " dmem=0x%03X guest=0x%06X len=0x%X"
+                " dma_fnv=%08X dma_nz=%u"
+                " source_event=%" PRIu64 " source_n=%u source_samples=%u"
+                " source_bytes=%u source_fnv=%08X source_nz=%u"
+                " consumer_event=%" PRIu64 " consumer_n=%u"
+                " consumer_samples=%u consumer_bytes=%u consumer_fnv=%08X"
+                " consumer_nz=%u\n",
+                task.n, i, joined.range.event, joined.range.dmem,
+                joined.range.dram, joined.range.len, joined.range.payload_fnv,
+                joined.range.payload_nz, source ? source->event : 0,
+                source ? source->n : 0, source ? source->samples : 0,
+                source ? source->bytes : 0, source ? source->fnv : 0,
+                source ? source->nonzero : 0, consumer ? consumer->event : 0,
+                consumer ? consumer->n : 0, consumer ? consumer->samples : 0,
+                consumer ? consumer->bytes : 0, consumer ? consumer->fnv : 0,
+                consumer ? consumer->nonzero : 0);
+    }
+    fflush(stderr);
+}
+
+static void audio_join_match_task_locked(AudioJoinTask& task) {
+    for (AudioJoinRange& joined : task.ranges) {
+        for (size_t i = 0; i < g_audio_join_pcm.size(); ++i) {
+            AudioJoinPcm& pcm = g_audio_join_pcm[i];
+            if (pcm.used || pcm.phase != task.phase ||
+                !audio_join_match(joined.range, pcm)) continue;
+            if (pcm.source && joined.source_pcm < 0) {
+                joined.source_pcm = static_cast<int>(i);
+                pcm.used = true;
+                break;
+            }
+            if (!pcm.source && joined.consumer_pcm < 0) {
+                joined.consumer_pcm = static_cast<int>(i);
+                pcm.used = true;
+                break;
+            }
+        }
+    }
+}
+
+static void audio_join_match_pcm_locked(size_t pcm_index) {
+    AudioJoinPcm& pcm = g_audio_join_pcm[pcm_index];
+    for (AudioJoinTask& task : g_audio_join_tasks) {
+        if (task.phase != pcm.phase) continue;
+        for (AudioJoinRange& joined : task.ranges) {
+            if (!audio_join_match(joined.range, pcm)) continue;
+            if (pcm.source && joined.source_pcm < 0) {
+                joined.source_pcm = static_cast<int>(pcm_index);
+                pcm.used = true;
+                audio_join_report_locked(task);
+                return;
+            }
+            if (!pcm.source && joined.consumer_pcm < 0) {
+                joined.consumer_pcm = static_cast<int>(pcm_index);
+                pcm.used = true;
+                audio_join_report_locked(task);
+                return;
+            }
+        }
+    }
+}
