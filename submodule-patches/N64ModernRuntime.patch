+static void rs64_log_ai_status(const char* api, uint32_t result,
+                               uint32_t buffered, uint32_t arg0,
+                               uint32_t arg1) {
+    if (!rs64_ai_status_probe_enabled()) return;
+    const uint32_t width = rs64_vi_committed_width();
+    const uint32_t origin = rs64_vi_committed_origin() & 0x00FFFFFFu;
+    const bool target = (width == 1024u && origin == 0x00790400u) ||
+                        (width == 512u && origin == 0x006AB400u);
+    static uint32_t target_rows = 0;
+    static uint32_t control_rows = 0;
+    if (target) {
+        static uint32_t phase_key = 0xFFFFFFFFu;
+        const uint32_t current_key = (width << 24) ^ origin;
+        if (current_key != phase_key) {
+            phase_key = current_key;
+            target_rows = 0;
+        }
+        if (target_rows >= 512u) return;
+        ++target_rows;
+        std::fprintf(stderr,
+                     "[m5-audio-drain] api=%s phase=%u width=%u origin=0x%06X"
+                     " result=%u buffered=%u arg0=0x%08X arg1=0x%08X\n",
+                     api, rs64_phase_ord(), width, origin, result, buffered,
+                     arg0, arg1);
+        std::fflush(stderr);
+    } else if (control_rows++ == 0) {
+        std::fprintf(stderr,
+                     "[ai-status-control] api=%s phase=%u width=%u"
+                     " origin=0x%06X result=%u buffered=%u\n",
+                     api, rs64_phase_ord(), width, origin, result, buffered);
+        std::fflush(stderr);
+    }
+}
