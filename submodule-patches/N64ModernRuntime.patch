+static void rs64_log_ai_output(uint8_t* rdram, uint32_t addr, uint32_t len) {
+    static const bool enabled = [] {
+        const char* all = std::getenv("ROGUESQ_LOG_ALL");
+        const char* own = std::getenv("ROGUESQ_LOG_PCM_BOUNDARY");
+        return (all && all[0] && all[0] != '0') ||
+               (own && own[0] && own[0] != '0');
+    }();
+    if (!enabled || len == 0 || len > 0x40000u) return;
+    const uint32_t width = rs64_vi_committed_width();
+    const uint32_t origin = rs64_vi_committed_origin() & 0x00FFFFFFu;
+    const bool title = width == 1024u && origin == 0x00790400u;
+    const bool hangar = width == 512u && origin == 0x006AB400u;
+    if (!title && !hangar) return;
+    static uint32_t phase_key = 0xFFFFFFFFu;
+    static uint32_t n = 0;
+    const uint32_t key = (width << 24) ^ origin;
+    if (key != phase_key) {
+        phase_key = key;
+        n = 0;
+    }
+    const uint8_t* p = TO_PTR(uint8_t, (uint64_t)(int32_t)addr);  // sign-extend KSEG0 addr (s4232)
+    uint32_t fnv = 2166136261u;
+    uint32_t nonzero = 0;
+    for (uint32_t i = 0; i < len; i++) {
+        fnv = (fnv * 16777619u) ^ p[(i) ^ 3];
+        nonzero += p[(i) ^ 3] != 0;
+    }
+    ++n;
+    if (title && n <= 3000u) {
+        static const bool s4239 = [] { const char* e = std::getenv("ROGUESQ_S4239"); return e && *e && *e != '0'; }();
+        if (s4239) {
+            double ss = 0; int32_t pk = 0;
+            for (uint32_t i = 0; i + 1 < len; i += 2) { int32_t v = (int16_t)((p[(i) ^ 3] << 8) | p[(i + 1) ^ 3]); ss += (double)v * v; int32_t a = v < 0 ? -v : v; if (a > pk) pk = a; }
+            std::fprintf(stderr, "[s4239-ai] n=%u addr=0x%06X fnv=0x%08X rms=%.0f peak=%d\n", n, addr & 0x7FFFFFu, fnv, std::sqrt(ss / (len / 2)), pk);
+        }
+    }
+    if (n <= 20 || (n % 128) == 0) {
+        std::fprintf(stderr,
+                     "[ai-output] bucket=%s phase=%u width=%u origin=0x%06X"
+                     " addr=0x%08X len=%u fnv=0x%08X nz=%u n=%u\n",
+                     title ? "title" : "hangar", rs64_phase_ord(), width, origin,
+                     addr, len, fnv, nonzero, n);
+        // s4236: per-channel stats to split constant/saturated fill from real audio.
+        int32_t mn[2] = {32767, 32767}, mx[2] = {-32768, -32768};
+        std::unordered_set<int16_t> distinct[2];
+        for (uint32_t i = 0; i + 3 < len; i += 4) {
+            for (uint32_t c = 0; c < 2; c++) {
+                const int16_t v = (int16_t)((p[(i + 2 * c) ^ 3] << 8) | p[(i + 2 * c + 1) ^ 3]);
+                if (v < mn[c]) mn[c] = v;
+                if (v > mx[c]) mx[c] = v;
+                distinct[c].insert(v);
+            }
+        }
+        // s4238: clip fraction (|x|>=32000) and RMS over both channels, for port-vs-retail loudness.
+        uint64_t clipped = 0, total = 0;
+        double sumsq = 0.0;
+        for (uint32_t i = 0; i + 1 < len; i += 2) {
+            const int32_t v = (int16_t)((p[(i) ^ 3] << 8) | p[(i + 1) ^ 3]);
+            if (v >= 32000 || v <= -32000) clipped++;
+            sumsq += (double)v * v;
+            total++;
+        }
+        std::fprintf(stderr, "[ai-output-clip] bucket=%s n=%u clipped=%llu total=%llu rms=%.1f\n",
+                     title ? "title" : "hangar", n, (unsigned long long)clipped,
+                     (unsigned long long)total, total ? std::sqrt(sumsq / total) : 0.0);
+        std::fprintf(stderr,
+                     "[ai-output-stats] bucket=%s n=%u addr=0x%08X L[min=%d max=%d distinct=%zu]"
+                     " R[min=%d max=%d distinct=%zu] head=",
+                     title ? "title" : "hangar", n, addr, mn[0], mx[0], distinct[0].size(),
+                     mn[1], mx[1], distinct[1].size());
+        for (uint32_t i = 0; i < 32 && i < len; i++) std::fprintf(stderr, "%02X", p[(i) ^ 3]);
+        std::fprintf(stderr, "\n");
+        std::fflush(stderr);
+    }
+}
