+void log_vi_parity_scheduler_commit(uint64_t callback_ordinal,
+                                    uint64_t current_total_vis,
+                                    uint64_t delta_total_vis,
+                                    uint32_t selected_field,
+                                    uint32_t current_line_bit,
+                                    uint32_t committed_origin,
+                                    uint32_t width) {
+    if (!vi_parity_scheduler_log_enabled() || callback_ordinal == 0) return;
+
+    ViParitySchedulerTrace& trace = vi_parity_scheduler_trace;
+    if (trace.all_width_prefix_rows < 8) {
+        const uint32_t prefix = trace.all_width_prefix_rows++;
+        std::fprintf(stderr,
+            "[vi-parity-scheduler-control] arm=%s prefix=%u callback=%" PRIu64
+            " total_vis=%" PRIu64 " delta=%" PRIu64 " width=%u\n",
+            vi_context_port_arm(), prefix, callback_ordinal, current_total_vis,
+            delta_total_vis, width);
+        std::fflush(stderr);
+    }
+
+    if (width != 640) return;
+    if (trace.rows >= 512) {
+        trace.overflow++;
+        return;
+    }
+
+    const uint32_t row = trace.rows++;
+    const size_t bucket = vi_context_port_origin_bucket(committed_origin);
+    if (selected_field < 2) trace.origin_field[bucket][selected_field]++;
+    if (delta_total_vis > 1) trace.skipped++;
+    if (delta_total_vis > trace.max_delta) trace.max_delta = delta_total_vis;
+
+    std::fprintf(stderr,
+        "[vi-parity-scheduler] arm=%s row=%u callback=%" PRIu64
+        " callback_parity=%u total_vis=%" PRIu64 " total_parity=%u"
+        " delta=%" PRIu64 " field=%u current_line=%u origin=0x%08X\n",
+        vi_context_port_arm(), row, callback_ordinal,
+        static_cast<uint32_t>(callback_ordinal & 1u), current_total_vis,
+        static_cast<uint32_t>(current_total_vis & 1u), delta_total_vis,
+        selected_field, current_line_bit & 1u, committed_origin);
+    std::fflush(stderr);
+
+    if ((trace.rows == 64 || trace.rows == 128 || trace.rows == 192 ||
+         trace.rows == 256 || trace.rows == 512) && trace.summaries < 5) {
+        trace.summaries++;
