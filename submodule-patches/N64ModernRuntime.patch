+void log_m5_origin_publish(uint32_t origin, uint32_t width, uint32_t framebuffer,
+                           uint32_t phase) {
+    if (!m5_origin_publish_log_enabled()) return;
+    static uint32_t all_rows = 0;
+    static uint32_t last_phase = 0xFFFFFFFFu;
+    static uint32_t phase_rows = 0;
+    if (phase != last_phase) {
+        last_phase = phase;
+        phase_rows = 0;
+    }
+    const bool target = (width == 1024u && origin == 0x00790400u) ||
+                        (width == 512u && origin == 0x006AB400u);
+    if (!target && all_rows >= 8u) return;
+    if (target && phase_rows >= 64u) return;
+    std::fprintf(stderr,
+        "[m5-origin-publish] control=%u target=%u phase=%u width=%u "
+        "origin=0x%06X framebuffer=0x%06X row=%u\n",
+        target ? 0u : 1u, target ? 1u : 0u, phase, width,
+        origin & 0x00FFFFFFu, framebuffer & 0x00FFFFFFu,
+        target ? phase_rows : all_rows);
+    std::fflush(stderr);
+    if (target) ++phase_rows;
+    else ++all_rows;
+}
