+static void audio_join_match_task_locked(AudioJoinTask& task) {
+    for (AudioJoinRange& joined : task.ranges) {
+        for (size_t i = 0; i < g_audio_join_pcm.size(); ++i) {
+            AudioJoinPcm& pcm = g_audio_join_pcm[i];
+            if (pcm.used || pcm.phase != task.phase ||
+                !audio_join_match(joined.range, pcm)) continue;
+            if (pcm.source && joined.source_pcm < 0) {
+                joined.source_pcm = static_cast<int>(i);
+                pcm.used = true;
+                break;
+            }
+            if (!pcm.source && joined.consumer_pcm < 0) {
+                joined.consumer_pcm = static_cast<int>(i);
+                pcm.used = true;
+                break;
+            }
+        }
+    }
+}
+
+static void audio_join_match_pcm_locked(size_t pcm_index) {
+    AudioJoinPcm& pcm = g_audio_join_pcm[pcm_index];
+    for (AudioJoinTask& task : g_audio_join_tasks) {
+        if (task.phase != pcm.phase) continue;
+        for (AudioJoinRange& joined : task.ranges) {
+            if (!audio_join_match(joined.range, pcm)) continue;
+            if (pcm.source && joined.source_pcm < 0) {
+                joined.source_pcm = static_cast<int>(pcm_index);
+                pcm.used = true;
+                audio_join_report_locked(task);
+                return;
+            }
+            if (!pcm.source && joined.consumer_pcm < 0) {
+                joined.consumer_pcm = static_cast<int>(pcm_index);
+                pcm.used = true;
+                audio_join_report_locked(task);
+                return;
+            }
+        }
+    }
+}
