+static void audio_hash_rdram(const uint8_t* rdram, uint32_t addr, uint32_t len,
+                             uint32_t& fnv, uint32_t& nonzero) {
+    fnv = 2166136261u;
+    nonzero = 0;
+    for (uint32_t i = 0; i < len; i++) {
+        const uint8_t b = rdram[(addr + i) & 0x007FFFFFu];
+        fnv = (fnv * 16777619u) ^ b;
+        nonzero += b != 0;
+    }
+}
