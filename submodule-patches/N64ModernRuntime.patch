+static bool audio_dma_overlaps(uint32_t dram, uint32_t len, int32_t ptr,
+                               int32_t size) {
+    const uint32_t start = static_cast<uint32_t>(ptr) & 0x007FFFFFu;
+    const uint32_t span = static_cast<uint32_t>(size);
+    if (span == 0 || start >= (rs64_ram_top - 0x80000000u)) return false;
+    const uint64_t end = static_cast<uint64_t>(start) + span;
+    return static_cast<uint64_t>(dram) < end &&
+           static_cast<uint64_t>(dram) + len > start;
+}
