+extern "C" void rs64_audio_join_image_complete(const char* arm,
+                                                  uint32_t ordinal, uint32_t row,
+                                                  uint32_t phase, uint32_t width,
+                                                  uint32_t origin) {
+    std::lock_guard<std::mutex> lock(g_audio_join_mutex);
+    audio_image_scope_locked(phase, width, origin);
+    const uint64_t complete_event = audio_join_next_event();
+    static const bool log_completion_call = [] {
+        const char* all = std::getenv("ROGUESQ_LOG_ALL");
+        const char* specific = std::getenv("ROGUESQ_LOG_M5_COMPLETION_CALL");
+        return (all && *all && *all != '0') ||
+               (specific && *specific && *specific != '0');
+    }();
+    const bool target_phase = (width == 1024 && origin == 0x00790400) ||
+                              (width == 512 && origin == 0x006AB400);
+    if (log_completion_call && target_phase) {
+        fprintf(stderr,
+                "[audtask-image-complete-call] arm=%s ordinal=%u row=%u phase=%u"
+                " width=%u origin=0x%06X event=%" PRIu64 "\n",
+                arm ? arm : "n/a", ordinal, row, phase, width, origin,
+                complete_event);
+        fflush(stderr);
+    }
+    for (AudioImageStage& stage : g_audio_image_stages) {
+        if (stage.ordinal != ordinal || stage.phase != phase ||
+            stage.row != row || std::strcmp(stage.arm, arm) != 0) continue;
+        stage.complete_event = complete_event;
+        audio_image_report_locked(stage);
+    }
+}
