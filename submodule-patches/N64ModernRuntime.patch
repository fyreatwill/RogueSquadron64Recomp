+extern "C" void rs64_audio_join_image_source(
+    const char* arm, uint32_t ordinal, uint32_t row, uint32_t phase,
+    uint32_t width, uint32_t origin, uint64_t source_event,
+    uint32_t task_data_ptr, uint32_t dram, uint32_t len, uint32_t fnv,
+    uint32_t nonzero, uint64_t task_generation, uint32_t handoff_thread,
+    uint32_t event_thread, uint32_t input_fnv, uint32_t input_nonzero,
+    uint32_t input_dram, uint32_t input_len, uint32_t input_dmem,
+    uint32_t input_task_data_ptr) {
+    std::lock_guard<std::mutex> lock(g_audio_join_mutex);
+    audio_image_scope_locked(phase, width, origin);
+    if (len == 0 || g_audio_image_sources.size() >= 8192) return;
+    AudioImageSource source{arm, ordinal, row, phase, width, origin,
+                            audio_join_next_event(), source_event,
+                            task_data_ptr, task_generation, handoff_thread,
+                            event_thread, dram & 0x007FFFFFu, len, fnv, nonzero};
+    source.input_fnv = input_fnv;
+    source.input_nonzero = input_nonzero;
+    source.input_dram = input_dram;
+    source.input_len = input_len;
+    source.input_dmem = input_dmem;
+    source.input_task_data_ptr = input_task_data_ptr;
+    g_audio_image_sources.push_back(source);
+    if ((g_audio_image_sources.size() & 0xFFu) == 0) {
+        audio_image_source_census_locked(phase, width, origin);
+    }
+    for (AudioImageStage& stage : g_audio_image_stages) {
+        if (stage.source_match == 0 && stage.phase == phase &&
+            stage.width == width && stage.origin == origin &&
+            stage.task_data_ptr == task_data_ptr &&
+            std::strcmp(stage.arm ? stage.arm : "n/a", arm ? arm : "n/a") == 0) {
+            audio_image_match_source_locked(stage);
+        }
+    }
+}
