+    void rs64DepthHistCaptureGuest(const char *site, const uint8_t *swapped, uint32_t swappedBytes, uint32_t width, uint32_t rowCount, uint32_t rowStart, uint32_t storeStride, uint32_t storeAddr, uint32_t lookupAddr) {
+        if (!depthDirOn()) {
+            return;
+        }
+        std::lock_guard<std::recursive_mutex> depthLock(g_depthMu);
+        rs64DepthHistNoteSite(site, width, rowCount, rowStart, storeStride, lookupAddr);
+        if (g_guestPending.armed != 1 || swapped == nullptr || rowCount == 0 || width < 34u) {
+            return;
+        }
+        const uint64_t need = uint64_t(width) * 2u * uint64_t(rowCount);
+        if (uint64_t(swappedBytes) < need) {
+            return;
+        }
+        g_guestPending.storeAddr = storeAddr;
+        uint32_t covers = 0;
+        for (uint32_t col = 0; col < 2; col++) {
+            const uint32_t x = col == 0 ? 16u : width - 17u;
+            for (uint32_t row = 0; row < kDepthRows; row++) {
+                const uint32_t y = 180u + row;
+                const uint32_t slot = col * kDepthRows + row;
+                if (y < rowStart || y >= rowStart + rowCount || x >= width) {
+                    g_guestPending.dec[slot] = -1.0f;
+                    g_guestPending.alt[slot] = -1.0f;
+                    continue;
+                }
+                const uint32_t index = (y - rowStart) * width + x;
+                uint16_t le = 0;
+                std::memcpy(&le, swapped + size_t(index) * 2u, 2);
+                const uint16_t be = rs64DepthRawBe(swapped, index * 2u);
+                g_guestPending.rawLe[slot] = le;
+                g_guestPending.rawBe[slot] = be;
+                g_guestPending.dec[slot] = ColorConverter::D16::toF(be);
+                g_guestPending.alt[slot] = ColorConverter::D16::toF(le);
+                if (col == 0) {
+                    covers++;
+                }
+            }
+        }
+        g_guestPending.covers = covers;
+        g_guestPending.armed = 2;
+        rs64FloorCopyNoteUpload(site, width, rowCount, rowStart, storeStride, storeAddr, lookupAddr);
+    }
+
+    void rs64DepthHistSetup(RenderWorker *worker, RenderTexture *depth, uint32_t address, uint32_t width, uint32_t height, RenderFormat format, float clearValue) {
+        (void)worker;
+        if (!depthDirOn() || depth == nullptr || !depthWatched(width, width)) {
+            return;
+        }
+        std::lock_guard<std::recursive_mutex> depthLock(g_depthMu);
+        const uint64_t ptr = reinterpret_cast<uint64_t>(depth);
+        if (DepthTrack *slot = depthTrack(ptr, true)) {
+            slot->dirty = 1;
+            slot->seen = 0;
+        }
+        if (g_depthEvents.size() >= 8192u) {
+            return;
+        }
+        DepthHistEvent ev = {};
+        std::snprintf(ev.kind, sizeof(ev.kind), "setup");
+        ev.depthTex = ptr;
+        ev.phase = rs64_phase_ord();
+        ev.addr = address;
+        ev.depthW = width;
+        ev.depthH = height;
+        ev.colorFmt = uint32_t(format);
+        ev.clearValue = clearValue;
+        ev.sample = -1;
+        g_depthEvents.push_back(ev);
+        depthWriteEvent(ev);
+    }
+
+    bool rs64DepthHistBeginZ(RenderWorker *worker) {
+        if (!depthDirOn() || worker == nullptr || worker->commandList == nullptr) {
+            return false;
+        }
+        std::lock_guard<std::recursive_mutex> depthLock(g_depthMu);
+        if (g_depthClosed) {
+            return false;
+        }
+        if (g_rs64FloorFragments == nullptr || g_rs64FloorFragmentZero == nullptr || g_rs64FloorBufferBytes < kDepthZBytes) {
+            return false;
+        }
+        if (!depthEnsureBuffers(worker)) {
+            return false;
+        }
+        worker->commandList->barriers(RenderBarrierStage::COPY, RenderBufferBarrier(g_rs64FloorFragments, RenderBufferAccess::WRITE));
+        worker->commandList->copyBufferRegion(g_rs64FloorFragments, g_rs64FloorFragmentZero, kDepthZBytes);
+        worker->commandList->barriers(RenderBarrierStage::GRAPHICS, RenderBufferBarrier(g_rs64FloorFragments, RenderBufferAccess::WRITE));
+        return true;
+    }
+
+    bool rs64DepthHistCaptureDraw(uint32_t width, int zUpd, int x0, int y0, int x1, int y1) {
+        if (!depthDirOn() || !zUpd || rs64_phase_ord() < 4 || !depthWatched(width, width)) {
+            return false;
+        }
+        std::lock_guard<std::recursive_mutex> depthLock(g_depthMu);
+        if (g_depthClosed) {
+            return false;
+        }
+        if (g_depthSamples + 1u >= kDepthCap) {
+            g_depthOverflow = 1;
+            return false;
+        }
+        return depthHitsBand(x0, y0, x1, y1, width);
+    }
+
+    void rs64DepthHistSample(RenderWorker *worker, const char *kind, RenderTexture *depth, RenderTexture *color, RenderFormat colorFormat, uint32_t colorAddr, uint32_t colorW, uint32_t colorH, uint32_t depthW, uint32_t depthH, uint64_t frame, uint32_t pair, int x0, int y0, int x1, int y1, int whole, int zCmp, int zUpd, int depthCmp, int depthWr, int faces, int captureZ) {
+        if (!depthDirOn()) {
+            return;  // s7375: off -> nothing ever arms g_guestPending, so no clear (was a two-thread write)
+        }
+        std::lock_guard<std::recursive_mutex> depthLock(g_depthMu);
+        const bool isCopy = kind != nullptr && depthIsCopyKind(kind);
+        if (g_depthClosed || depth == nullptr || kind == nullptr) {
+            if (isCopy) depthClearGuest();
+            return;
+        }
+        if (rs64_phase_ord() < 4) {
+            if (isCopy) depthClearGuest();
+            return;
+        }
+        if (!depthWatched(colorW, depthW)) {
+            if (isCopy) depthClearGuest();
+            if (std::strcmp(kind, "floor-enter") == 0) {
+                g_depthClosed = true;
+            }
+            return;
+        }
+        const bool isEnter = std::strcmp(kind, "enter") == 0;
+        const bool isFloor = std::strcmp(kind, "floor-enter") == 0;
+        const uint64_t ptr = reinterpret_cast<uint64_t>(depth);
+        DepthTrack *slot = depthTrack(ptr, true);
+        // Unchanged wide targets stay out of the sample cap. Writers and the
+        // floor-enter sample always record. setup() marks a new texture dirty.
+        if (isEnter && slot != nullptr && slot->seen && !slot->dirty) {
+            g_depthSkipped++;
+            return;
+        }
+        const uint32_t bandW = colorW != 0 ? colorW : depthW;
+        const bool canCopy = worker != nullptr && worker->commandList != nullptr && depthH >= 251u && bandW >= 34u &&
+            (isFloor || g_depthSamples + 1u < kDepthCap) && g_depthSamples < kDepthCap && depthEnsureBuffers(worker);
+        if (!canCopy && !isFloor && g_depthSamples + 1u >= kDepthCap) {
+            g_depthOverflow = 1;
+        }
+        DepthHistEvent ev = {};
+        std::snprintf(ev.kind, sizeof(ev.kind), "%s", kind);
+        ev.depthTex = ptr;
+        ev.colorTex = reinterpret_cast<uint64_t>(color);
+        ev.phase = rs64_phase_ord();
+        ev.addr = colorAddr;
+        ev.colorAddr = colorAddr;
+        ev.colorW = colorW;
+        ev.colorH = colorH;
+        ev.depthW = depthW;
+        ev.depthH = depthH;
+        ev.colorFmt = uint32_t(colorFormat);
+        ev.frame = frame;
+        ev.pair = pair;
+        ev.x0 = x0;
+        ev.y0 = y0;
+        ev.x1 = x1;
+        ev.y1 = y1;
+        ev.whole = whole;
+        ev.zCmp = zCmp;
+        ev.zUpd = zUpd;
+        ev.depthCmp = depthCmp;
+        ev.depthWr = depthWr;
+        ev.faces = faces;
+        ev.captureZ = 0;
+        ev.sample = -1;
+        if (canCopy) {
+            const uint32_t sample = g_depthSamples++;
