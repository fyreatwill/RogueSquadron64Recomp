+                const uint32_t slot = xi * 14u + yi;
+                const uint32_t abs = kDepthOrigin + kRdramYs[yi] * kDepthStride + kRdramXs[xi] * 2u;
+                uint16_t raw = 0;
+                const int ok = rdramSample(buf, phys0, nbytes, abs, rdramOrder, &raw);
+                if (inside != nullptr) {
+                    inside[slot] = ok ? 1u : 0u;
+                }
+                cols[slot] = ok ? raw : 0u;
+            }
+        }
+    }
+
+    CopyRamLog &copyRamLog() {
+        static CopyRamLog log;
+        return log;
+    }
+
+    void copyRamCounts(char *dst, size_t n, const CopyRamLog &log) {
+        std::snprintf(dst, n, "[%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu]",
+            (unsigned long long)log.bySiz[0], (unsigned long long)log.bySiz[1],
+            (unsigned long long)log.bySiz[2], (unsigned long long)log.bySiz[3],
+            (unsigned long long)log.bySiz[4], (unsigned long long)log.bySiz[5],
+            (unsigned long long)log.bySiz[6], (unsigned long long)log.bySiz[7]);
+    }
+
+    bool copyRamOpen(CopyRamLog &log) {
+        if (log.fp != nullptr) {
+            return true;
+        }
+        if (!depthDirOn() || g_depthDir == nullptr) {
+            return false;
+        }
+        char path[1024];
+        std::snprintf(path, sizeof(path), "%s/copytoram.jsonl", g_depthDir);
+        log.fp = std::fopen(path, "wb");
+        if (!log.opened) {
+            log.opened = 1;
+            std::fprintf(stderr, "[copytoram] open %s ok=%d\n", path, log.fp != nullptr);
+            std::fflush(stderr);
+        }
+        return log.fp != nullptr;
+    }
+
+    bool rdramOpen(CopyRamLog &log) {
+        if (log.rd != nullptr) {
+            return true;
+        }
+        if (!depthDirOn() || g_depthDir == nullptr) {
+            return false;
+        }
+        char path[1024];
+        std::snprintf(path, sizeof(path), "%s/rdram.jsonl", g_depthDir);
+        log.rd = std::fopen(path, "wb");
+        if (!log.rdOpened) {
+            log.rdOpened = 1;
+            std::fprintf(stderr, "[rdram] open %s ok=%d\n", path, log.rd != nullptr);
+            std::fflush(stderr);
+        }
+        return log.rd != nullptr;
+    }
+    }
