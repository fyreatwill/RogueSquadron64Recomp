+    static bool ost_wb_log_enabled() {
+        static int cached = -1;
+        if (cached < 0) {
+            const char *e = std::getenv("ROGUESQ_LOG_OST_WB");
+            cached = (e && e[0] && e[0] != '0') ? 1 : 0;
+        }
+        return cached != 0;
+    }
