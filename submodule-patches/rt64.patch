+                            for (int sz = 0; sz < 4; sz++) {
+                                const uint64_t c = g_rs64LoadHist[f][sz].load();
+                                if (c) fprintf(stderr, " f%d/s%d=%llu", f, sz, (unsigned long long)c);
+                            }
+                        }
+                        fprintf(stderr, "\n");
+                        fflush(stderr);
+                        // Stream-order dump: what texture setup led to this draw.
+                        rs64TexSeqPush(Rs64TexRec{
+                            Rs64TexOp::Draw, t.fmt, t.siz, (uint8_t)(tile % RDP_TILES),
+                            t.line, t.tmem, 0, 0, 0, t.lrs, t.lrt,
+                            lo.texture.address, g_rs64LoadSeq.load()
