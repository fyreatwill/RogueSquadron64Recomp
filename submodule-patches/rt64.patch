+// ROGUESQ_LOG_STAGES=1 (session 32) — exhaustive phase-scoped stage counters.
+// Thousands of RDP draws are seen while only ~150 game calls reach workloads;
+// these four counters localise which stage drops them. Counts EVERY event and
+// prints a running total periodically, so the printed maximum is exact.
+namespace {
+    inline void rs64_stage_count(const char *tag, unsigned nth) {
+        static const bool on = []{
+            const char *e = std::getenv("ROGUESQ_LOG_STAGES");
+            return e && *e && *e != '0';
+        }();
+        if (!on) return;
+        struct Slot { std::atomic<unsigned> n{0}; std::atomic<unsigned> phase{0xFFFFFFFFu}; };
+        static std::mutex mu;
+        static std::map<std::string, std::pair<unsigned, unsigned>> slots; // tag -> (phase, count)
+        const unsigned phase = rs64_phase_ord ? rs64_phase_ord() : 0u;
+        unsigned c = 0;
+        {
+            std::lock_guard<std::mutex> lk(mu);
+            auto &s = slots[tag];
+            if (s.first != phase) { s.first = phase; s.second = 0; }
+            c = ++s.second;
+        }
+        if ((c % nth) == 0 || c == 1) {
+            fprintf(stderr, "[stage %s ph%u] n=%u\n", tag, phase, c);
+            fflush(stderr);
+        }
+    }
+
+    // Session 33 follow-up: accumulate an AMOUNT (e.g. triangles per call), so
+    // both sides of a comparison can be measured in the same unit. A "game call"
+    // is a BATCH of triangles, so counting calls against triangle draws compares
+    // different things — which is how s33 read batching as loss.
+    inline void rs64_stage_add(const char *tag, unsigned amount, unsigned nth) {
+        static const bool on = []{
+            const char *e = std::getenv("ROGUESQ_LOG_STAGES");
+            return e && *e && *e != '0';
+        }();
+        if (!on) return;
+        static std::mutex mu2;
+        static std::map<std::string, std::pair<unsigned, unsigned long long>> acc; // tag -> (phase, total)
+        static std::map<std::string, unsigned long long> bucket;
+        const unsigned phase = rs64_phase_ord ? rs64_phase_ord() : 0u;
+        unsigned long long total = 0;
+        bool print = false;
+        {
+            std::lock_guard<std::mutex> lk(mu2);
+            auto &a = acc[tag];
+            if (a.first != phase) { a.first = phase; a.second = 0; bucket[tag] = 0; }
+            a.second += amount;
+            total = a.second;
+            if (total / nth > bucket[tag]) { bucket[tag] = total / nth; print = true; }
+        }
+        if (print) {
+            fprintf(stderr, "[stage %s ph%u] total=%llu\n", tag, phase, total);
+            fflush(stderr);
+        }
+    }
+}
