+    static void ost_wb_read_fields(const uint8_t *RDRAM, uint64_t *ctx_out, int32_t *pri_out) {
+        std::memcpy(ctx_out, RDRAM + kOstWatchPhys + kOstCtxOff, sizeof(*ctx_out));
+        std::memcpy(pri_out, RDRAM + kOstWatchPhys + kOstPriOff, sizeof(*pri_out));
+    }
+
+    // Call immediately before a writeback; returns write [start,end) and whether it
+    // overlaps the watched OSThread. Logs OVERLAP always; control at a low rate.
+    static void ost_wb_before(const char *tag, const uint8_t *RDRAM,
+                              uint32_t addressStart, uint32_t rowWidth, uint8_t siz,
+                              uint32_t rowStart, uint32_t rowEnd,
+                              uint32_t *writeStartOut, uint32_t *writeEndOut, bool *overlapOut,
+                              uint64_t *ctxBeforeOut, int32_t *priBeforeOut) {
+        const uint32_t rowBytes = (uint32_t)rowWidth << siz >> 1;
+        const uint32_t writeStart = addressStart + rowStart * rowBytes;
+        const uint32_t writeEnd = addressStart + rowEnd * rowBytes;
+        const uint32_t watchEnd = kOstWatchPhys + kOstWatchSize;
+        const bool overlap = (writeStart < watchEnd) && (writeEnd > kOstWatchPhys);
+        *writeStartOut = writeStart;
+        *writeEndOut = writeEnd;
+        *overlapOut = overlap;
+
+        uint64_t ctx = 0;
+        int32_t pri = 0;
+        ost_wb_read_fields(RDRAM, &ctx, &pri);
+        *ctxBeforeOut = ctx;
+        *priBeforeOut = pri;
+
+        std::lock_guard<std::mutex> lock(g_ost_wb_mu);
+        if (g_ost_have_ctx && ctx != g_ost_last_ctx) {
+            const uint32_t n = ++g_ost_wb_ctx_pre;
+            std::fprintf(stderr,
+                "[ost-wb] CTX_CHANGED_PRE #%u tag=%s prev=0x%llx now=0x%llx pri=%d "
+                "wb=[0x%X,0x%X) addr=0x%X rows=%u..%u w=%u siz=%u overlap=%d\n",
+                n, tag,
+                (unsigned long long)g_ost_last_ctx, (unsigned long long)ctx, (int)pri,
+                writeStart, writeEnd, addressStart, rowStart, rowEnd, rowWidth, (unsigned)siz,
+                overlap ? 1 : 0);
+            std::fflush(stderr);
+        }
+        g_ost_last_ctx = ctx;
+        g_ost_have_ctx = true;
+
+        if (overlap) {
+            const uint32_t n = ++g_ost_wb_overlap;
+            std::fprintf(stderr,
+                "[ost-wb] OVERLAP #%u tag=%s wb=[0x%X,0x%X) len=%u watch=[0x%X,0x%X) "
+                "addr=0x%X rows=%u..%u w=%u siz=%u ctx_before=0x%llx pri=%d\n",
+                n, tag, writeStart, writeEnd, writeEnd - writeStart,
+                kOstWatchPhys, watchEnd,
+                addressStart, rowStart, rowEnd, rowWidth, (unsigned)siz,
+                (unsigned long long)ctx, (int)pri);
+            std::fflush(stderr);
+        } else {
+            const uint32_t n = ++g_ost_wb_control;
+            if (n <= 20 || (n % 500) == 0) {
+                std::fprintf(stderr,
+                    "[ost-wb] control #%u tag=%s wb=[0x%X,0x%X) addr=0x%X "
+                    "rows=%u..%u w=%u siz=%u ctx=0x%llx pri=%d\n",
+                    n, tag, writeStart, writeEnd, addressStart,
+                    rowStart, rowEnd, rowWidth, (unsigned)siz,
+                    (unsigned long long)ctx, (int)pri);
+                std::fflush(stderr);
+            }
+        }
+    }
+
+    static void ost_wb_after(const char *tag, const uint8_t *RDRAM,
+                             uint32_t writeStart, uint32_t writeEnd, bool overlap,
+                             uint64_t ctxBefore, int32_t priBefore) {
+        uint64_t ctx = 0;
+        int32_t pri = 0;
+        ost_wb_read_fields(RDRAM, &ctx, &pri);
+        std::lock_guard<std::mutex> lock(g_ost_wb_mu);
+        g_ost_last_ctx = ctx;
+        g_ost_have_ctx = true;
+        if (ctx != ctxBefore || pri != priBefore) {
+            const uint32_t n = ++g_ost_wb_ctx_by_wb;
+            std::fprintf(stderr,
+                "[ost-wb] CTX_CHANGED_BY_WB #%u tag=%s overlap=%d wb=[0x%X,0x%X) "
+                "ctx 0x%llx->0x%llx pri %d->%d\n",
+                n, tag, overlap ? 1 : 0, writeStart, writeEnd,
+                (unsigned long long)ctxBefore, (unsigned long long)ctx,
+                (int)priBefore, (int)pri);
+            std::fflush(stderr);
+        } else if (overlap) {
+            std::fprintf(stderr,
+                "[ost-wb] OVERLAP_NO_CTX_CHANGE tag=%s wb=[0x%X,0x%X) ctx=0x%llx pri=%d\n",
+                tag, writeStart, writeEnd, (unsigned long long)ctx, (int)pri);
+            std::fflush(stderr);
+        }
+    }
