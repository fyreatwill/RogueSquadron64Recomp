+    static void rs64RdpHistCount(uint8_t opCode) {
+        static uint64_t counts[64] = {};
+        static uint64_t prev[64] = {};
+        static uint64_t total = 0;
+        static std::chrono::steady_clock::time_point last;
+
+        counts[opCode & 0x3F]++;
+        total++;
+
+        // Report on a wall clock, not a command count: the whole question is
+        // what the stream looks like per unit of time during the 20 s stall.
+        const auto now = std::chrono::steady_clock::now();
+        if (last.time_since_epoch().count() == 0) {
+            last = now;
+            return;
+        }
+
+        const double ms = std::chrono::duration<double, std::milli>(now - last).count();
+        if (ms < 2000.0) {
+            return;
+        }
+
+        last = now;
+
+        struct Named { uint8_t op; const char *name; };
+        static const Named named[] = {
+            { 0x29, "FULLSYNC" }, { 0x3F, "SETCIMG" },  { 0x3E, "SETZIMG" },
+            { 0x3D, "SETTIMG" },  { 0x36, "FILLRECT" }, { 0x24, "TEXRECT" },
+            { 0x2D, "SCISSOR" },  { 0x3C, "COMBINE" },  { 0x2F, "OTHERMODE" },
+            { 0x33, "LOADBLOCK" },{ 0x35, "SETTILE" },  { 0x27, "SYNCPIPE" },
+            { 0x28, "SYNCTILE" }, { 0x26, "SYNCLOAD" },
+        };
+
+        uint64_t tris = 0, trisPrev = 0;
+        for (uint8_t op = 0x08; op <= 0x0F; op++) {
+            tris += counts[op];
+            trisPrev += prev[op];
+        }
+
+        fprintf(stderr, "[rdphist] %.0fms total=%llu", ms, (unsigned long long)total);
+        for (const Named &n : named) {
+            const uint64_t d = counts[n.op] - prev[n.op];
+            if (counts[n.op] != 0) {
+                fprintf(stderr, " %s=%llu(+%llu)", n.name,
+                        (unsigned long long)counts[n.op], (unsigned long long)d);
+            }
+        }
+        fprintf(stderr, " TRI=%llu(+%llu)",
+                (unsigned long long)tris, (unsigned long long)(tris - trisPrev));
+        // Break the triangles down by opcode. The lumped TRI bucket cannot
+        // answer the question that matters when a scene renders as flat
+        // colour: RDP triangle opcodes encode whether the primitive carries
+        // texture coordinates (0x0A/0x0B, 0x0E/0x0F) or only shade
+        // (0x08/0x09, 0x0C/0x0D), so the split says whether the display list
+        // asked for texturing at all before any of RT64's machinery runs.
+        {
+            static const char *triName[8] = {
+                "fill", "fillZ", "tex", "texZ", "shade", "shadeZ", "shTex", "shTexZ",
+            };
+            fprintf(stderr, " [");
+            bool first = true;
+            for (uint8_t op = 0x08; op <= 0x0F; op++) {
+                if (counts[op] == 0) continue;
+                fprintf(stderr, "%s%s=%llu(+%llu)", first ? "" : " ",
+                        triName[op - 0x08], (unsigned long long)counts[op],
+                        (unsigned long long)(counts[op] - prev[op]));
+                first = false;
+            }
+            fprintf(stderr, "]\n");
+        }
+        fflush(stderr);
+
+        for (int i = 0; i < 64; i++) {
+            prev[i] = counts[i];
+        }
+    }
