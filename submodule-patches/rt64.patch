+    static void ost_wb_after(const char *tag, const uint8_t *RDRAM,
+                             uint32_t writeStart, uint32_t writeEnd, bool overlap,
+                             uint64_t ctxBefore, int32_t priBefore) {
+        uint64_t ctx = 0;
+        int32_t pri = 0;
+        ost_wb_read_fields(RDRAM, &ctx, &pri);
