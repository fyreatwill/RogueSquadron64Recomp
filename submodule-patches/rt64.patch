+        // ROGUESQ_DUMP_TMEM_DRAW=1 — dump the CPU-side TMEM image at draw time
+        // for the RGBA32 population. Session 18 proved the RDRAM source decodes
+        // to clean sky tiles and that this geometry nonetheless paints black.
+        // TMEM sits exactly between the two: if it holds the sky, LOADBLOCK is
+        // fine and the bug is in the GPU decode/hash/sampler; if it is zeroed,
+        // the bug is the RGBA32 load path. No GPU readback needed.
+        {
+            static const bool s_dump = []{
+                const char *e = std::getenv("ROGUESQ_DUMP_TMEM_DRAW");
+                return e && *e && *e != '0';
+            }();
+            if (s_dump) {
+                const auto &t = tiles[tile % RDP_TILES];
+                if ((t.fmt == G_IM_FMT_RGBA) && (t.siz == G_IM_SIZ_32b)) {
+                    static std::atomic<int> n{0};
+                    const int i = ++n;
+                    if (i <= 3) {
+                        char path[128];
+                        std::snprintf(path, sizeof(path), "tmem_draw_%d_line%u_tmem%u.bin",
+                                      i, (unsigned)t.line, (unsigned)t.tmem);
+                        FILE *fp = std::fopen(path, "wb");
+                        if (fp) {
+                            std::fwrite(TMEM, 1, sizeof(TMEM), fp);
+                            std::fclose(fp);
+                        }
+                        // Non-zero byte count says at a glance whether TMEM was
+                        // filled at all, without waiting for the offline decode.
+                        const uint8_t *bytes = reinterpret_cast<const uint8_t *>(TMEM);
+                        size_t nz = 0;
+                        for (size_t k = 0; k < sizeof(TMEM); k++) if (bytes[k]) nz++;
+                        // Split the count by half: RGBA32 keeps RG in the low
+                        // half and BA in the high half, so "which half is
+                        // empty" is the whole question.
+                        size_t nzLo = 0, nzHi = 0;
+                        const size_t half = sizeof(TMEM) / 2;
+                        for (size_t k = 0; k < half; k++) if (bytes[k]) nzLo++;
+                        for (size_t k = half; k < sizeof(TMEM); k++) if (bytes[k]) nzHi++;
