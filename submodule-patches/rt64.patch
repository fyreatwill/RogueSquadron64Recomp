+                "[ost-wb] OVERLAP #%u tag=%s wb=[0x%X,0x%X) len=%u watch=[0x%X,0x%X) "
+                "addr=0x%X rows=%u..%u w=%u siz=%u ctx_before=0x%llx pri=%d\n",
