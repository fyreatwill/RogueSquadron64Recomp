+                              uint32_t rowStart, uint32_t rowEnd,
+                              uint32_t *writeStartOut, uint32_t *writeEndOut, bool *overlapOut,
+                              uint64_t *ctxBeforeOut, int32_t *priBeforeOut) {
+        const uint32_t rowBytes = (uint32_t)rowWidth << siz >> 1;
+        const uint32_t writeStart = addressStart + rowStart * rowBytes;
+        const uint32_t writeEnd = addressStart + rowEnd * rowBytes;
+        const uint32_t watchEnd = kOstWatchPhys + kOstWatchSize;
+        const bool overlap = (writeStart < watchEnd) && (writeEnd > kOstWatchPhys);
+        *writeStartOut = writeStart;
+        *writeEndOut = writeEnd;
+        *overlapOut = overlap;
