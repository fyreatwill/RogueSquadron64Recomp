+        std::lock_guard<std::mutex> lock(g_ost_wb_mu);
+        if (g_ost_have_ctx && ctx != g_ost_last_ctx) {
+            const uint32_t n = ++g_ost_wb_ctx_pre;
+            std::fprintf(stderr,
+                "[ost-wb] CTX_CHANGED_PRE #%u tag=%s prev=0x%llx now=0x%llx pri=%d "
