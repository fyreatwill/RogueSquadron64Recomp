+                        // describing 4 KB of RGBA32 over a 2 KB 16-bit load
+                        // would leave exactly this signature, and only the load
+                        // record can tell the two apart.
+                        const LoadOperation &lo = rice.lastLoadOpByTMEM[t.tmem % RDP_TMEM_WORDS];
+                        const char *ty = (lo.type == LoadOperation::Type::Tile) ? "Tile"
+                                       : (lo.type == LoadOperation::Type::Block) ? "Block" : "TLUT";
+                        fprintf(stderr,
+                            "[tmem-draw #%d] renderTile: fmt=%u siz=%u line=%u tmem=0x%X "
+                            "masks=%u/%u lrs=%u | nonzero lo=%zu/%zu hi=%zu/%zu\n",
+                            i, (unsigned)t.fmt, (unsigned)t.siz, (unsigned)t.line,
+                            (unsigned)t.tmem, (unsigned)t.masks, (unsigned)t.maskt,
+                            (unsigned)t.lrs, nzLo, half, nzHi, half);
+                        fprintf(stderr,
+                            "[tmem-draw #%d] lastLoad@tmem0x%X: type=%s loadTile(fmt=%u siz=%u "
+                            "line=%u tmem=0x%X lrs=%u) texture(fmt=%u siz=%u addr=0x%06X w=%u)\n",
+                            i, (unsigned)t.tmem, ty,
+                            (unsigned)lo.tile.fmt, (unsigned)lo.tile.siz, (unsigned)lo.tile.line,
+                            (unsigned)lo.tile.tmem, (unsigned)lo.tile.lrs,
+                            (unsigned)lo.texture.fmt, (unsigned)lo.texture.siz,
+                            lo.texture.address & 0xFFFFFF, (unsigned)lo.texture.width);
+                        fprintf(stderr,
+                            "[tmem-draw #%d] loads so far=%llu; last RGBA32 load was #%llu "
+                            "(addr=0x%06X) => %llu loads ago\n",
+                            i, (unsigned long long)g_rs64LoadSeq.load(),
+                            (unsigned long long)g_rs64LastRGBA32Seq.load(),
+                            g_rs64LastRGBA32Addr.load(),
+                            (unsigned long long)(g_rs64LoadSeq.load() - g_rs64LastRGBA32Seq.load()));
