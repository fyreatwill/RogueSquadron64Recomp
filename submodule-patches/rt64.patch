+    // Host-layout OSThread in RDRAM (recomp mode): sizeof=48, pri@4, context@32.
+    static constexpr uint32_t kOstWatchPhys = 0x1494B0u;
+    static constexpr uint32_t kOstWatchSize = 48u;
+    static constexpr uint32_t kOstPriOff = 4u;
+    static constexpr uint32_t kOstCtxOff = 32u;
+    static constexpr uint32_t kRdramBytes = 0x1000000u; // s6130: 16 MB
+    static constexpr uint32_t kMaxSaneFbWidth = 1280u;
+
+    static std::atomic<uint32_t> g_ost_wb_control{0};
+    static std::atomic<uint32_t> g_ost_wb_overlap{0};
+    static std::atomic<uint32_t> g_ost_wb_ctx_by_wb{0};
+    static std::atomic<uint32_t> g_ost_wb_ctx_pre{0};
+    static std::atomic<uint32_t> g_ost_wb_skip{0};
+    static uint64_t g_ost_last_ctx = 0;
+    static bool g_ost_have_ctx = false;
+    static std::mutex g_ost_wb_mu;
+
+    // Returns false if writeback must be skipped (caller still keeps CIMG for draw).
+    static bool rs64_writeback_sane(const char *tag, uint32_t addressStart,
+                                    uint32_t rowWidth, uint8_t siz,
+                                    uint32_t rowStart, uint32_t rowEnd,
+                                    RT64::Framebuffer *fb) {
+        if (addressStart < 0x100000u) {
+            return false; // existing low-mem floor (caller usually gates this already)
+        }
+        if (rowWidth == 0 || rowWidth > kMaxSaneFbWidth) {
+            const uint32_t n = ++g_ost_wb_skip;
+            if (n <= 20 || (n % 50) == 0) {
+                std::fprintf(stderr,
+                    "[ost-wb] SKIP_WIDTH #%u tag=%s addr=0x%X w=%u siz=%u rows=%u..%u\n",
+                    n, tag, addressStart, rowWidth, (unsigned)siz, rowStart, rowEnd);
+                std::fflush(stderr);
+            }
+            return false;
+        }
+        // s653: allowlist matches s82 last-drawn present filter. s652 freeroll
+        // Outcome B: w=1161/h=277/siz=3 addr=0x1F0D74 passed the ≤1280 cap but
+        // wrote range [0x1F0D74,0x32AE68) over freelist phys 0x1F3CC0 — co-timed
+        // 0x2/0x60→0. Real VI widths in this game are only 320/512/640/1024.
+        //
+        // s659 productize (item -412, policy A): freelist-range writebacks are
+        // ALLOWED even at wild widths so copyNativeToRAM can complete writeback
+        // then restore the 16B freelist header (H-wb-complete-not-stomp). Non-
+        // freelist wild widths still SKIP_WILD_W. ROGUESQ_ALLOW_WILD_W=1 still
+        // disables all SKIP_WILD_W (A/B). ROGUESQ_FL_HDR_HARD_SKIP=1 restores
+        // the pre-s659 hard SKIP_FL_HDR for A/B rollback.
+        const bool allowW = (rowWidth == 320u || rowWidth == 512u ||
+                             rowWidth == 640u || rowWidth == 1024u ||
+                             (rowWidth != 0u && rowWidth == []{ static const uint32_t w = []{ const char* e = std::getenv("ROGUESQ_FB_WIDTH"); return (e && *e) ? (uint32_t)std::atoi(e) : 0u; }(); return w; }()));
+        const uint32_t rowBytes = (uint32_t)rowWidth << siz >> 1;
+        if (rowBytes == 0) {
+            return false;
+        }
+        const uint64_t writeStart = (uint64_t)addressStart + (uint64_t)rowStart * (uint64_t)rowBytes;
+        const uint64_t writeEnd = (uint64_t)addressStart + (uint64_t)rowEnd * (uint64_t)rowBytes;
+        if (writeEnd > kRdramBytes) {
+            const uint32_t n = ++g_ost_wb_skip;
+            if (n <= 20 || (n % 50) == 0) {
+                std::fprintf(stderr,
+                    "[ost-wb] SKIP_OOB #%u tag=%s addr=0x%X w=%u siz=%u rows=%u..%u end=0x%llx\n",
+                    n, tag, addressStart, rowWidth, (unsigned)siz, rowStart, rowEnd,
+                    (unsigned long long)writeEnd);
+                std::fflush(stderr);
+            }
+            return false;
+        }
+        static constexpr uint32_t kFlHdrPhys = 0x1F3CC0u;
+        const bool coversFlHdr = (writeStart <= kFlHdrPhys && kFlHdrPhys < writeEnd);
+
+        static int s_allow_wild_w = -1;
+        if (s_allow_wild_w < 0) {
+            const char *e = std::getenv("ROGUESQ_ALLOW_WILD_W");
+            s_allow_wild_w = (e && e[0] == '1') ? 1 : 0;
+            if (s_allow_wild_w) {
+                std::fprintf(stderr,
+                    "[ost-wb] ALLOW_WILD_W=1 (SKIP_WILD_W disabled for A/B)\n");
+                std::fflush(stderr);
+            }
+        }
+        // Policy A: wild width that covers freelist is NOT skipped — product
+        // restore in copyNativeToRAM needs writeback to run.
+        if (!allowW && !s_allow_wild_w && !coversFlHdr) {
+            const uint32_t n = ++g_ost_wb_skip;
+            if (n <= 40 || (n % 100) == 0) {
+                std::fprintf(stderr,
+                    "[ost-wb] SKIP_WILD_W #%u tag=%s addr=0x%X w=%u siz=%u rows=%u..%u\n",
+                    n, tag, addressStart, rowWidth, (unsigned)siz, rowStart, rowEnd);
+                std::fflush(stderr);
+            }
+            return false;
+        }
+        if (!allowW && coversFlHdr) {
+            static uint32_t s_wild_fl_allow_n = 0;
+            const uint32_t n = ++s_wild_fl_allow_n;
+            if (n <= 40 || (n % 100) == 0) {
+                int match = 0;
+                uint32_t ff_w0 = 0, ff_w1 = 0, fe_w0 = 0, fe_w1 = 0;
+                uint32_t last_ff_w0 = 0, last_ff_w1 = 0, last_fe_w0 = 0, last_fe_w1 = 0;
+                uint32_t ff_n = 0, fe_n = 0;
+                rs64_lookup_image_word(rowWidth, &match, &ff_w0, &ff_w1, &fe_w0, &fe_w1,
+                    &last_ff_w0, &last_ff_w1, &last_fe_w0, &last_fe_w1, &ff_n, &fe_n);
+                const char *img = "none";
+                if (match == 3) {
+                    img = "both";
+                } else if (match == 1) {
+                    img = "ff";
+                } else if (match == 2) {
+                    img = "fe";
+                }
+                uint32_t fbWidth = 0, fbHeight = 0;
+                uint32_t nativeReadbackBufferSize = 0;
+                uint32_t histIdx = 0, histCount = 0;
+                if (fb != nullptr) {
+                    fbWidth = fb->width;
+                    fbHeight = fb->height;
+                    histIdx = fb->nativeTarget.writeBufferHistoryIndex;
+                    histCount = fb->nativeTarget.writeBufferHistoryCount;
+                    if (histIdx < fb->nativeTarget.writeBufferHistory.size()) {
+                        nativeReadbackBufferSize =
+                            fb->nativeTarget.writeBufferHistory[histIdx].nativeReadbackBufferSize;
+                    }
+                }
+                // Same uint32 multiply as NativeTarget::getNativeSize, so these
+                // are the values copyToRAM is about to pass to memcpy.
+                const uint32_t bufferOffset = rowBytes * rowStart;
+                const uint32_t bufferSize = rowBytes * (rowEnd - rowStart);
+                std::fprintf(stderr,
+                    "[ost-wb] ALLOW_WILD_FL #%u tag=%s addr=0x%X w=%u siz=%u "
+                    "rows=%u..%u fb=%ux%u range=[0x%llx,0x%llx) hdr=0x%X "
+                    "nativeReadbackBufferSize=%u bufferOffset=%u bufferSize=%u "
+                    "hist=%u/%u img=%s img_w0=0x%08X img_w1=0x%08X "
+                    "ff_w0=0x%08X ff_w1=0x%08X fe_w0=0x%08X fe_w1=0x%08X "
+                    "lastff=0x%08X/0x%08X lastfe=0x%08X/0x%08X ff_n=%u fe_n=%u "
+                    "(product restore path)\n",
+                    n, tag, addressStart, rowWidth, (unsigned)siz,
+                    rowStart, rowEnd, fbWidth, fbHeight,
+                    (unsigned long long)writeStart, (unsigned long long)writeEnd,
+                    kFlHdrPhys, nativeReadbackBufferSize, bufferOffset, bufferSize,
+                    histIdx, histCount, img,
+                    (match & 1) ? ff_w0 : ((match & 2) ? fe_w0 : 0u),
+                    (match & 1) ? ff_w1 : ((match & 2) ? fe_w1 : 0u),
+                    ff_w0, ff_w1, fe_w0, fe_w1,
+                    last_ff_w0, last_ff_w1, last_fe_w0, last_fe_w1, ff_n, fe_n);
+                std::fflush(stderr);
+            }
+        }
+
+        // s4548: hard skip of freelist-range writeback is the DEFAULT. The s659
+        // allow lets the wild-width SETCIMG (s4531) clobber the sample heap
+        // (s4546: 2/2 wipes adjacent, HARD_SKIP survives 3/3). Set
+        // ROGUESQ_FL_HDR_HARD_SKIP=0 to restore the s659 allow policy.
+        static int s_fl_hard_skip = -1;
+        if (s_fl_hard_skip < 0) {
+            const char *e = std::getenv("ROGUESQ_FL_HDR_HARD_SKIP");
+            s_fl_hard_skip = (e && e[0] == '0') ? 0 : 1;
+            if (s_fl_hard_skip) {
+                std::fprintf(stderr,
+                    "[ost-wb] FL_HDR_HARD_SKIP=1 (default since s4548)\n");
+                std::fflush(stderr);
+            }
+        }
+        if (s_fl_hard_skip && coversFlHdr) {
+            const uint32_t n = ++g_ost_wb_skip;
+            if (n <= 40 || (n % 100) == 0) {
+                std::fprintf(stderr,
+                    "[ost-wb] SKIP_FL_HDR #%u tag=%s addr=0x%X w=%u siz=%u "
+                    "range=[0x%llx,0x%llx) hdr=0x%X\n",
+                    n, tag, addressStart, rowWidth, (unsigned)siz,
+                    (unsigned long long)writeStart, (unsigned long long)writeEnd,
+                    kFlHdrPhys);
+                std::fflush(stderr);
+            }
+            return false;
+        }
+        return true;
+    }
