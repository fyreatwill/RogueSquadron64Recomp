+namespace {
+    static bool band_wb_enabled() {
+        static const bool on = [] {
+            const char *v = std::getenv("ROGUESQ_LOG_FB_BAND_WB");
+            return v && *v && *v != '0';
+        }();
+        return on;
+    }
+    struct BandSource { uint32_t phase, address, width, height, b0, b1; };
+    static std::mutex bandSourceMutex;
+    static std::vector<BandSource> bandSources;
+    static void band_source_register(uint32_t phase, uint32_t address,
+                                     uint32_t width, uint32_t height, uint32_t siz) {
+        if (!band_wb_enabled() || siz != 2 || !height ||
+            (width != 512 && width != 796 && width != 1024) ||
+            uint64_t(address) + uint64_t(width) * height * 2 > 0x1000000) return;
+        std::lock_guard<std::mutex> lock(bandSourceMutex);
+        if (!bandSources.empty() && bandSources.front().phase != phase) bandSources.clear();
+        for (const auto &s : bandSources)
+            if (s.address == address && s.width == width && s.height == height) return;
+        if (bandSources.size() < 8) bandSources.push_back({phase, address, width, height,
+            width == 512 ? 0u : (width == 796 ? 269u : 347u),
+            width == 512 ? width : (width == 796 ? 335u : 640u)});
+    }
+    static uint32_t band_changed(const std::vector<uint8_t> &a, const std::vector<uint8_t> &b) {
+        uint32_t n = 0;
+        for (size_t i = 0; i < a.size(); ++i) n += a[i] != b[i];
+        return n;
+    }
+    struct BandWriteback {
+        struct Sample { BandSource source; std::vector<uint8_t> before, control; uint32_t overlap; };
+        uint8_t *ram;
+        uint32_t phase = 0, start = 0, end = 0;
+        std::vector<Sample> samples;
+        static std::vector<uint8_t> read(uint8_t *ram, const BandSource &s, bool control) {
+            std::vector<uint8_t> out;
+            uint32_t b0 = control ? 0 : s.b0;
+            uint32_t b1 = control ? std::min(64u, s.b0 ? s.b0 : s.width) : s.b1;
+            out.reserve((b1 - b0) * s.height * 2);
+            for (uint32_t y = 0; y < s.height; ++y) {
+                uint32_t a = s.address + (y * s.width + b0) * 2;
+                out.insert(out.end(), ram + a, ram + a + (b1 - b0) * 2);
+            }
+            return out;
+        }
+        static uint64_t hash(const std::vector<uint8_t> &a) {
+            uint64_t h = 1469598103934665603ull;
+            for (uint8_t b : a) { h ^= b; h *= 1099511628211ull; }
+            return h;
+        }
+        BandWriteback(uint8_t *r, uint32_t address, uint32_t width, uint32_t siz,
+                      uint32_t rowStart, uint32_t rowEnd) : ram(r) {
+            if (!band_wb_enabled()) return;
+            static const bool ctl = [] {
+                std::vector<uint8_t> a{0, 1, 2, 3}, b = a;
+                b[2] ^= 1;
+                std::fprintf(stderr, "[fb-band-wb-control] identical=%u injected=%u\n",
+                    band_changed(a, a), band_changed(a, b));
+                return true;
+            }();
+            (void)ctl;
+            phase = rs64_phase_ord ? rs64_phase_ord() : 0;
+            static uint32_t lastPhase = ~0u, budget = 0;
+            if (lastPhase != phase) { lastPhase = phase; budget = 0; }
+            if (budget++ >= 128) return;
+            start = address + ((rowStart * width) << siz >> 1);
+            end = address + ((rowEnd * width) << siz >> 1);
+            std::lock_guard<std::mutex> lock(bandSourceMutex);
+            for (const auto &s : bandSources) {
+                if (s.phase != phase) continue;
+                uint32_t overlap = 0;
+                for (uint32_t y = 0; y < s.height; ++y) {
+                    uint32_t a = s.address + (y * s.width + s.b0) * 2;
+                    uint32_t b = s.address + (y * s.width + s.b1) * 2;
+                    if (std::max(a, start) < std::min(b, end))
+                        overlap += std::min(b, end) - std::max(a, start);
+                }
+                samples.push_back({s, read(ram, s, false), read(ram, s, true), overlap});
+            }
+        }
+        ~BandWriteback() {
+            for (const auto &sample : samples) {
+                const auto &s = sample.source;
+                const auto after = read(ram, s, false);
+                const auto ctl = read(ram, s, true);
+                std::fprintf(stderr,
+                    "[fb-band-wb] phase=%u source=0x%06X width=%u height=%u band=%u..%u "
+                    "write=[0x%06X,0x%06X) overlap_bytes=%u changed_bytes=%u control_changed=%u "
+                    "pre=%016llX post=%016llX\n", phase, s.address, s.width, s.height, s.b0, s.b1,
+                    start, end, sample.overlap, band_changed(sample.before, after),
+                    band_changed(sample.control, ctl), (unsigned long long)hash(sample.before),
+                    (unsigned long long)hash(after));
+            }
+        }
+    };
