+    void rs64FloorCopyNoteUpload(const char *site, uint32_t width, uint32_t rowCount, uint32_t rowStart, uint32_t stride, uint32_t storeAddr, uint32_t lookupAddr) {
+        if (!depthDirOn() || g_guestPending.armed != 2) {
+            return;
+        }
+        CopyRamLog &log = copyRamLog();
+        std::lock_guard<std::mutex> lock(log.mu);
+        if (!copyRamOpen(log)) {
+            return;
+        }
+        const uint64_t n = ++log.seq;
+        char counts[160];
+        copyRamCounts(counts, sizeof(counts), log);
+        std::string raw;
+        raw.reserve(256);
+        for (uint32_t col = 0; col < 2; col++) {
+            for (uint32_t row = 0; row < 13; row++) {
+                const uint32_t slot = col * kDepthRows + row;
+                if (!raw.empty()) {
+                    raw += ',';
+                }
+                raw += std::to_string(g_guestPending.rawBe[slot]);
+            }
+        }
+        std::fprintf(log.fp,
+            "{\"k\":\"up\",\"n\":%llu,\"site\":\"%s\",\"width\":%u,\"height\":%u,\"rowStart\":%u,"
+            "\"stride\":%u,\"store\":%u,\"lookup\":%u,\"calls\":%s,\"rawBe\":[%s]}\n",
+            (unsigned long long)n, site != nullptr ? site : "", width, rowCount, rowStart,
+            stride, storeAddr, lookupAddr, counts, raw.c_str());
+        std::fflush(log.fp);
+    }
+
+    void rs64FloorCopyToRamWitness(uint32_t rowStart, uint32_t rowEnd, uint32_t width, uint8_t siz, uint8_t *destination, const uint8_t *native, uint32_t nativeBytes) {
+        if (!depthDirOn()) {
+            return;
+        }
+        CopyRamLog &log = copyRamLog();
+        std::lock_guard<std::mutex> lock(log.mu);
+        const uint32_t bucket = siz < 8u ? siz : 7u;
+        log.bySiz[bucket]++;
+        const uint64_t n = ++log.seq;
+        g_rdramHold.n = n;
+        g_rdramHold.copied = (native != nullptr && nativeBytes >= 2u) ? 1 : 0;
+        if (!copyRamOpen(log)) {
+            return;
+        }
+        char counts[160];
+        copyRamCounts(counts, sizeof(counts), log);
+        const bool wide = siz == G_IM_SIZ_16b && (width == 796u || width == 1024u);
+        if (!wide) {
+            if (n == 1u || (n % 64u) == 0u) {
+                std::fprintf(log.fp, "{\"k\":\"n\",\"n\":%llu,\"siz\":%u,\"width\":%u,\"calls\":%s}\n",
+                    (unsigned long long)n, siz, width, counts);
+                std::fflush(log.fp);
+            }
+            return;
+        }
+        uint32_t phys = 0xFFFFFFFFu;
+        const uintptr_t base = reinterpret_cast<uintptr_t>(g_recomp_rdram_for_wp_raw);
+        const uintptr_t dest = reinterpret_cast<uintptr_t>(destination);
+        if (destination != nullptr && base != 0 && dest >= base) {
+            const uintptr_t off = dest - base;
+            if (off <= 0x1FFFFFFFu) {
+                phys = (uint32_t)off;
+            }
+        }
+        const int copied = (native != nullptr && nativeBytes >= 2u && rowEnd > rowStart) ? 1 : 0;
+        const uint32_t rowBytes = width << 1;
+        std::string words;
+        if (copied && rowBytes != 0 && uint64_t(rowEnd - rowStart) * rowBytes <= nativeBytes) {
+            static const uint32_t ys[14] = {180, 181, 182, 183, 184, 185, 186, 187, 188, 189, 190, 191, 192, 200};
+            const uint32_t xs[2] = {16u, width - 17u};
+            for (uint32_t y : ys) {
+                if (y < rowStart || y >= rowEnd) {
+                    continue;
+                }
+                for (uint32_t x : xs) {
+                    if (x >= width) {
+                        continue;
+                    }
+                    const uint32_t rel = (y - rowStart) * rowBytes + x * 2u;
+                    if (uint64_t(rel) + 2u > nativeBytes) {
+                        continue;
+                    }
+                    const uint16_t rawBe = rs64DepthRawBe(native, rel);
+                    const uint32_t pix = phys == 0xFFFFFFFFu ? 0xFFFFFFFFu : phys + rel;
+                    if (!words.empty()) {
+                        words += ',';
+                    }
+                    words += "{\"x\":" + std::to_string(x) + ",\"y\":" + std::to_string(y)
+                        + ",\"rawBe\":" + std::to_string(rawBe) + ",\"phys\":" + std::to_string(pix) + "}";
+                }
+            }
+            // Depth pixels live at 0xB56000, which a taller color writeback can cover
+            // at a different image y. Sample those absolute addresses too.
+            if (phys != 0xFFFFFFFFu) {
+                const uint32_t span = (rowEnd - rowStart) * rowBytes;
+                const uint32_t depthOrigin = 0x00B56000u;
+                const uint32_t depthStride = 2048u;
+                const uint32_t depthXs[2] = {16u, 1024u - 17u};
+                for (uint32_t y : ys) {
+                    for (uint32_t x : depthXs) {
+                        const uint32_t addr = depthOrigin + y * depthStride + x * 2u;
+                        if (addr < phys || uint64_t(addr) + 2u > uint64_t(phys) + span) {
+                            continue;
+                        }
+                        const uint32_t rel = addr - phys;
+                        if (uint64_t(rel) + 2u > nativeBytes) {
+                            continue;
+                        }
+                        const uint16_t rawBe = rs64DepthRawBe(native, rel);
+                        if (!words.empty()) {
+                            words += ',';
+                        }
+                        words += "{\"x\":" + std::to_string(x) + ",\"y\":" + std::to_string(y)
+                            + ",\"rawBe\":" + std::to_string(rawBe) + ",\"phys\":" + std::to_string(addr)
+                            + ",\"watch\":1}";
+                    }
+                }
+            }
+        }
+        std::fprintf(log.fp,
+            "{\"k\":\"w\",\"n\":%llu,\"siz\":%u,\"width\":%u,\"phys\":%u,\"rowStart\":%u,\"rowEnd\":%u,"
+            "\"bytes\":%u,\"copied\":%d,\"calls\":%s,\"words\":[%s]}\n",
+            (unsigned long long)n, siz, width, phys, rowStart, rowEnd, nativeBytes, copied, counts, words.c_str());
+        std::fflush(log.fp);
+    }
+
+    void rs64FloorRdramPrepare(const uint8_t *nativeBytes, uint32_t phys0, uint32_t nbytes, Rs64RdramSnap *snap) {
+        std::memset(snap, 0, sizeof(*snap));
+        if (!depthDirOn() || !rdramWatchInside(phys0, nbytes)) {
+            return;
+        }
+        snap->present = 1;
+        snap->witnessN = g_rdramHold.n;
+        for (uint32_t xi = 0; xi < 2u; xi++) {
+            for (uint32_t yi = 0; yi < 14u; yi++) {
+                const uint32_t slot = xi * 14u + yi;
+                const uint32_t abs = kDepthOrigin + kRdramYs[yi] * kDepthStride + kRdramXs[xi] * 2u;
+                snap->colIn[slot] = (uint8_t)rdramColInside(phys0, nbytes, abs);
+            }
+        }
+        if (!g_rdramHold.copied || nativeBytes == nullptr) {
+            return;
+        }
+        uint16_t raw = 0;
+        if (rdramSample(nativeBytes, phys0, nbytes, kRdramWatch, 0, &raw)) {
+            snap->nativeValid = 1;
+            snap->nativeWatch = raw;
+            rdramFillCols(nativeBytes, phys0, nbytes, 0, snap->nativeCol, nullptr);
+        }
+    }
+
+    void rs64FloorRdramNoteSwap(const uint8_t *swapped, uint32_t phys0, uint32_t nbytes, Rs64RdramSnap *snap) {
+        if (snap == nullptr || !snap->present || swapped == nullptr) {
+            return;
+        }
+        uint16_t raw = 0;
+        if (!rdramSample(swapped, phys0, nbytes, kRdramWatch, 1, &raw)) {
+            return;
+        }
+        snap->swapValid = 1;
+        snap->swapWatch = raw;
+        rdramFillCols(swapped, phys0, nbytes, 1, snap->swapCol, nullptr);
+    }
+
+    void rs64FloorRdramLog(const char *site, const uint8_t *buf, uint32_t phys0, uint32_t nbytes, const Rs64RdramSnap *snap, int flRestore) {
+        if (!depthDirOn() || buf == nullptr || !rdramWatchInside(phys0, nbytes)) {
+            return;
+        }
+        if (snap != nullptr && !snap->present) {
+            return;
+        }
+        rs64_floor_writer_flush();
+        rs64_floor_writer_control();
+        CopyRamLog &log = copyRamLog();
+        std::lock_guard<std::mutex> lock(log.mu);
+        if (!rdramOpen(log)) {
+            return;
+        }
+        const uint64_t n = ++log.seq;
+        const uint32_t rel = kRdramWatch - phys0;
+        const uintptr_t host = reinterpret_cast<uintptr_t>(buf) + rel;
+        const uintptr_t rdram = reinterpret_cast<uintptr_t>(g_recomp_rdram_for_wp_raw);
+        const int eq = (rdram != 0 && host == rdram + kRdramWatch) ? 1 : 0;
+        const unsigned b0 = buf[rel];
+        const unsigned b1 = buf[rel + 1];
+        const unsigned b2 = buf[rel + 2];
+        const unsigned b3 = buf[rel + 3];
+        uint16_t rawWatch = 0;
+        rdramSample(buf, phys0, nbytes, kRdramWatch, 1, &rawWatch);
+        uint16_t rawCol[28] = {};
+        rdramFillCols(buf, phys0, nbytes, 1, rawCol, nullptr);
+        const int nativeValid = snap != nullptr && snap->nativeValid;
+        const int swapValid = snap != nullptr && snap->swapValid;
+        const int nativeWatch = nativeValid ? (int)snap->nativeWatch : -1;
+        const int swapWatch = swapValid ? (int)snap->swapWatch : -1;
+        std::string cols;
+        cols.reserve(28u * 96u);
+        for (uint32_t xi = 0; xi < 2u; xi++) {
+            for (uint32_t yi = 0; yi < 14u; yi++) {
+                const uint32_t slot = xi * 14u + yi;
+                const uint32_t abs = kDepthOrigin + kRdramYs[yi] * kDepthStride + kRdramXs[xi] * 2u;
+                const int inside = snap != nullptr ? (int)snap->colIn[slot] : rdramColInside(phys0, nbytes, abs);
+                const int native = (nativeValid && inside) ? (int)snap->nativeCol[slot] : -1;
+                const int sw = (swapValid && inside) ? (int)snap->swapCol[slot] : -1;
+                const int raw = inside ? (int)rawCol[slot] : -1;
+                if (!cols.empty()) {
+                    cols += ',';
+                }
+                cols += "{\"x\":" + std::to_string(kRdramXs[xi]) + ",\"y\":" + std::to_string(kRdramYs[yi])
+                    + ",\"in\":" + std::to_string(inside) + ",\"native\":" + std::to_string(native)
+                    + ",\"swap\":" + std::to_string(sw) + ",\"raw\":" + std::to_string(raw) + "}";
+            }
+        }
+        std::fprintf(log.rd,
+            "{\"k\":\"%s\",\"n\":%llu,\"wn\":%llu,\"phys0\":%u,\"nbytes\":%u,"
+            "\"host\":\"0x%llx\",\"rdram\":\"0x%llx\",\"eq\":%d,\"b4\":\"%02X%02X%02X%02X\","
+            "\"native\":%d,\"swap\":%d,\"raw\":%u,\"fl\":%d,\"cols\":[%s]}\n",
+            site != nullptr ? site : "", (unsigned long long)n,
+            (unsigned long long)(snap != nullptr ? snap->witnessN : 0u),
+            phys0, nbytes, (unsigned long long)host, (unsigned long long)rdram, eq,
+            b0, b1, b2, b3, nativeWatch, swapWatch, rawWatch, flRestore, cols.c_str());
+        std::fflush(log.rd);
+        static int seenA = 0;
+        static int seenB = 0;
+        int *seen = (site != nullptr && site[0] == 'b') ? &seenB : &seenA;
+        const int shown = ++*seen;
+        if (shown <= 2) {
+            std::fprintf(stderr, "[rdram] site=%s n=%llu eq=%d native=%d swap=%d raw=%u fl=%d\n",
+                site != nullptr ? site : "", (unsigned long long)n, eq, nativeWatch, swapWatch, rawWatch, flRestore);
+            std::fflush(stderr);
+        }
+    }
+
+
+    extern "C" void rs64FloorWriterRecord(const char* cls, uint32_t pc, uint32_t phys,
+        uint32_t len, uint32_t target, uint32_t before, uint32_t after,
+        const char* api, const char* caller) {
+        if (!depthDirOn()) return;
+        CopyRamLog &log = copyRamLog();
+        std::lock_guard<std::mutex> lock(log.mu);
+        if (!rdramOpen(log)) return;
+        std::fprintf(log.rd,
+            "{\"k\":\"writer\",\"n\":%llu,\"swap\":%d,\"epoch\":%d,\"class\":\"%s\",\"pc\":%u,\"phys\":%u,"
+            "\"len\":%u,\"target\":%u,\"before\":%u,\"after\":%u,\"api\":\"%s\",\"caller\":\"%s\"}\n",
+            (unsigned long long)++log.seq, g_rs64_swap_n.load(std::memory_order_relaxed),
+            __atomic_load_n(&rs64_g1d_vi_epoch, __ATOMIC_RELAXED), cls, pc, phys, len, target, before, after, api, caller);
+        std::fflush(log.rd);
+    }
