+                            colorImage.address & 0xFFFFFF, (unsigned)colorImage.width,
+                            (unsigned)colorImage.siz);
+                    fprintf(stderr,
+                        "[shade] usesTex0=%llu noTex=%llu usesTex1=%llu | fog=#%06X(a%.2f) "
+                        "prim=#%06X(a%.2f) env=#%06X(a%.2f) blend=#%06X fill=0x%08X | "
+                        "blenderInputs=0x%X forceBlend=%d cvgXAlpha=%d\n",
+                        (unsigned long long)nTex, (unsigned long long)nNoTex,
+                        (unsigned long long)nT1,
+                        hex(fog), f4(fog,3), hex(prim), f4(prim,3),
+                        hex(env), f4(env,3), hex(bl),
