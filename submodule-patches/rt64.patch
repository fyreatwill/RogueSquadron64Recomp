+                    for (size_t i = triPosFloats.size() - n; i < triPosFloats.size(); i++) {
+                        if (s_shift) {
+                            // X is component 0 of each 4-float vertex.
+                            if (((triPosFloats.size() - i) % PosFloatsPerVertex) == PosFloatsPerVertex) {
+                                continue;
+                            }
+                            const size_t off = (i - (triPosFloats.size() - n)) % PosFloatsPerVertex;
+                            if (off == 0) triPosFloats[i] += 80.0f;
+                        }
+                        else {
+                            triPosFloats[i] = 0.0f;
+                        }
+                    }
+                }
+            }
+        }
+
+        // ROGUESQ_LOG_UVSCALE=1 — texels-per-pixel census for textured
+        // triangles. A polygon that renders as one flat colour has two very
+        // different possible causes: the texture really is uniform, or the
+        // texture is fine and the mapping magnifies a single texel across the
+        // whole primitive. Every other instrument here (formats, dxt, sample
+        // bounds, TMEM) speaks to the first; this one separates the second,
+        // which no amount of load-side tuning would ever fix.
+        {
+            static const bool s_uv = []{
+                const char *e = std::getenv("ROGUESQ_LOG_UVSCALE");
+                return e && *e && *e != '0';
+            }();
+            if (s_uv && (drawCall.textureOn != 0) && (triCount > 0)) {
+                float umin = 1e9f, umax = -1e9f, vmin = 1e9f, vmax = -1e9f;
+                float xmin = 1e9f, xmax = -1e9f, ymin = 1e9f, ymax = -1e9f;
+                for (uint32_t i = 0; i < triCount * 3; i++) {
+                    const float x = pos[i * PosFloatsPerVertex + 0];
+                    const float y = pos[i * PosFloatsPerVertex + 1];
+                    const float u = tc[i * TcFloatsPerVertex + 0];
+                    const float v = tc[i * TcFloatsPerVertex + 1];
+                    xmin = std::min(xmin, x); xmax = std::max(xmax, x);
+                    ymin = std::min(ymin, y); ymax = std::max(ymax, y);
+                    umin = std::min(umin, u); umax = std::max(umax, u);
+                    vmin = std::min(vmin, v); vmax = std::max(vmax, v);
+                }
+                const float pxW = xmax - xmin, pxH = ymax - ymin;
+                const float tW = umax - umin, tH = vmax - vmin;
+                if (pxW > 1.0f && pxH > 1.0f) {
+                    const float ratio = std::max(tW / pxW, tH / pxH);
+                    // Buckets: heavy magnification, mild magnification, ~1:1,
+                    // minification. "Heavy" is the flat-colour signature.
+                    static std::mutex mu;
+                    static uint64_t bucket[4] = {};
+                    static uint64_t n = 0;
+                    static double sumRatio = 0.0;
+                    static std::chrono::steady_clock::time_point last;
+                    static float exU = 0, exV = 0, exX = 0, exY = 0;
+                    static uint8_t exFmt = 0, exSiz = 0;
+                    // Absolute coordinates and tile identity for one degenerate
+                    // and one healthy triangle: the span alone says the mapping
+                    // collapsed, not which texel it collapsed onto or whether
+                    // the two populations differ in tile setup.
+                    static float degU = 0, degV = 0; static uint16_t degLine = 0;
+                    static uint8_t degFmt = 0, degSiz = 0; static bool degSeen = false;
+                    static float okU = 0, okV = 0, okSpanU = 0, okSpanV = 0;
+                    static uint16_t okLine = 0; static uint8_t okFmt = 0, okSiz = 0;
+                    static bool okSeen = false;
+                    std::lock_guard<std::mutex> lk(mu);
+                    const int b = (ratio < 0.02f) ? 0 : (ratio < 0.5f) ? 1 : (ratio < 2.0f) ? 2 : 3;
+                    bucket[b]++; n++; sumRatio += ratio;
+                    const auto &probeTile = tiles[tile % RDP_TILES];
+                    if (b == 0 || n == 1) {
+                        exU = tW; exV = tH; exX = pxW; exY = pxH;
+                        exFmt = probeTile.fmt;
+                        exSiz = probeTile.siz;
+                    }
+                    if (b == 0 && !degSeen) {
+                        degU = umin; degV = vmin; degLine = probeTile.line;
+                        degFmt = probeTile.fmt; degSiz = probeTile.siz; degSeen = true;
+                    }
+                    if (b == 2 && !okSeen) {
+                        okU = umin; okV = vmin; okSpanU = tW; okSpanV = tH;
+                        okLine = probeTile.line;
+                        okFmt = probeTile.fmt; okSiz = probeTile.siz; okSeen = true;
+                    }
+                    const auto now = std::chrono::steady_clock::now();
+                    if (last.time_since_epoch().count() == 0) {
+                        last = now;
+                    } else if (std::chrono::duration<double>(now - last).count() >= 2.0) {
+                        last = now;
+                        std::fprintf(stderr,
+                            "[uvscale] n=%llu heavyMag=%llu mag=%llu near1=%llu min=%llu "
+                            "meanRatio=%.4f | example uv=%.1fx%.1f px=%.1fx%.1f fmt=%u siz=%u\n",
+                            (unsigned long long)n, (unsigned long long)bucket[0],
+                            (unsigned long long)bucket[1], (unsigned long long)bucket[2],
+                            (unsigned long long)bucket[3], n ? sumRatio / double(n) : 0.0,
+                            exU, exV, exX, exY, (unsigned)exFmt, (unsigned)exSiz);
+                        std::fprintf(stderr,
+                            "  [uvscale] degenerate: uv=(%.1f,%.1f) fmt=%u siz=%u line=%u | "
+                            "healthy: uv=(%.1f,%.1f) span=%.1fx%.1f fmt=%u siz=%u line=%u\n",
+                            degU, degV, (unsigned)degFmt, (unsigned)degSiz, (unsigned)degLine,
+                            okU, okV, okSpanU, okSpanV,
+                            (unsigned)okFmt, (unsigned)okSiz, (unsigned)okLine);
+                        std::fflush(stderr);
+                        bucket[0] = bucket[1] = bucket[2] = bucket[3] = 0;
+                        n = 0; sumRatio = 0.0;
+                        degSeen = false; okSeen = false;
+                    }
+                }
+            }
+        }
+
+        // ROGUESQ_DUMP_TMEM_DRAW=1 — dump the CPU-side TMEM image at draw time
+        // for the RGBA32 population. Session 18 proved the RDRAM source decodes
+        // to clean sky tiles and that this geometry nonetheless paints black.
+        // TMEM sits exactly between the two: if it holds the sky, LOADBLOCK is
+        // fine and the bug is in the GPU decode/hash/sampler; if it is zeroed,
+        // the bug is the RGBA32 load path. No GPU readback needed.
+        {
+            static const bool s_dump = []{
+                const char *e = std::getenv("ROGUESQ_DUMP_TMEM_DRAW");
+                return e && *e && *e != '0';
+            }();
+            if (s_dump) {
+                const auto &t = tiles[tile % RDP_TILES];
+                if ((t.fmt == G_IM_FMT_RGBA) && (t.siz == G_IM_SIZ_32b)) {
+                    static std::atomic<int> n{0};
+                    const int i = ++n;
+                    if (i <= 3) {
+                        char path[128];
+                        std::snprintf(path, sizeof(path), "tmem_draw_%d_line%u_tmem%u.bin",
+                                      i, (unsigned)t.line, (unsigned)t.tmem);
+                        FILE *fp = std::fopen(path, "wb");
+                        if (fp) {
+                            std::fwrite(TMEM, 1, sizeof(TMEM), fp);
+                            std::fclose(fp);
+                        }
+                        // Non-zero byte count says at a glance whether TMEM was
+                        // filled at all, without waiting for the offline decode.
+                        const uint8_t *bytes = reinterpret_cast<const uint8_t *>(TMEM);
+                        size_t nz = 0;
+                        for (size_t k = 0; k < sizeof(TMEM); k++) if (bytes[k]) nz++;
+                        // Split the count by half: RGBA32 keeps RG in the low
+                        // half and BA in the high half, so "which half is
+                        // empty" is the whole question.
+                        size_t nzLo = 0, nzHi = 0;
+                        const size_t half = sizeof(TMEM) / 2;
+                        for (size_t k = 0; k < half; k++) if (bytes[k]) nzLo++;
+                        for (size_t k = half; k < sizeof(TMEM); k++) if (bytes[k]) nzHi++;
+                        // The load that actually backs this tile. A render tile
+                        // describing 4 KB of RGBA32 over a 2 KB 16-bit load
+                        // would leave exactly this signature, and only the load
+                        // record can tell the two apart.
+                        const LoadOperation &lo = rice.lastLoadOpByTMEM[t.tmem % RDP_TMEM_WORDS];
+                        const char *ty = (lo.type == LoadOperation::Type::Tile) ? "Tile"
+                                       : (lo.type == LoadOperation::Type::Block) ? "Block" : "TLUT";
+                        fprintf(stderr,
+                            "[tmem-draw #%d] renderTile: fmt=%u siz=%u line=%u tmem=0x%X "
+                            "masks=%u/%u lrs=%u | nonzero lo=%zu/%zu hi=%zu/%zu\n",
+                            i, (unsigned)t.fmt, (unsigned)t.siz, (unsigned)t.line,
+                            (unsigned)t.tmem, (unsigned)t.masks, (unsigned)t.maskt,
+                            (unsigned)t.lrs, nzLo, half, nzHi, half);
+                        fprintf(stderr,
+                            "[tmem-draw #%d] lastLoad@tmem0x%X: type=%s loadTile(fmt=%u siz=%u "
+                            "line=%u tmem=0x%X lrs=%u) texture(fmt=%u siz=%u addr=0x%06X w=%u)\n",
+                            i, (unsigned)t.tmem, ty,
+                            (unsigned)lo.tile.fmt, (unsigned)lo.tile.siz, (unsigned)lo.tile.line,
+                            (unsigned)lo.tile.tmem, (unsigned)lo.tile.lrs,
+                            (unsigned)lo.texture.fmt, (unsigned)lo.texture.siz,
+                            lo.texture.address & 0xFFFFFF, (unsigned)lo.texture.width);
+                        fprintf(stderr,
+                            "[tmem-draw #%d] loads so far=%llu; last RGBA32 load was #%llu "
+                            "(addr=0x%06X) => %llu loads ago\n",
+                            i, (unsigned long long)g_rs64LoadSeq.load(),
+                            (unsigned long long)g_rs64LastRGBA32Seq.load(),
+                            g_rs64LastRGBA32Addr.load(),
+                            (unsigned long long)(g_rs64LoadSeq.load() - g_rs64LastRGBA32Seq.load()));
+                        fprintf(stderr, "[tmem-draw #%d] load census by fmt/siz:", i);
+                        for (int f = 0; f < 8; f++) {
+                            for (int sz = 0; sz < 4; sz++) {
+                                const uint64_t c = g_rs64LoadHist[f][sz].load();
+                                if (c) fprintf(stderr, " f%d/s%d=%llu", f, sz, (unsigned long long)c);
+                            }
+                        }
+                        fprintf(stderr, "\n");
+                        fflush(stderr);
+                        // Stream-order dump: what texture setup led to this draw.
+                        rs64TexSeqPush(Rs64TexRec{
+                            Rs64TexOp::Draw, t.fmt, t.siz, (uint8_t)(tile % RDP_TILES),
+                            t.line, t.tmem, 0, 0, 0, t.lrs, t.lrt,
+                            lo.texture.address, g_rs64LoadSeq.load()
+                        });
+                        char why[160];
+                        std::snprintf(why, sizeof(why),
+                            "RGBA32 draw tile tmem=0x%X lastLoad f%u/s%u a=0x%06X",
+                            (unsigned)t.tmem,
+                            (unsigned)lo.texture.fmt, (unsigned)lo.texture.siz,
+                            lo.texture.address & 0xFFFFFF);
+                        rs64TexSeqDump(why);
+                    }
+                }
+            }
+        }
+
+        // ROGUESQ_LOG_SHADE=1 — does the combiner actually USE the texture, and
+        // what flat colours / vertex shades are live? Session 19 overturned the
+        // "RGBA32 never loads" theory: TMEM at upload has both halves filled
+        // and mixed alpha. Opaque black silhouettes over a sand fill are then
+        // explained by either a combiner that multiplies by a near-zero shade,
+        // or a blender that ignores the texel. Print vertex colour min/max for
+        // textured draws so that can be told apart from fog.
+        {
+            static const bool s_log = []{
+                const char *e = std::getenv("ROGUESQ_LOG_SHADE");
+                return e && *e && *e != '0';
+            }();
+            if (s_log && (triCount > 0)) {
+                const auto &cc = colorCombinerStack[colorCombinerStackSize - 1];
+                const bool usesT0 = cc.usesTexture(otherMode, 0, false);
+                const bool usesT1 = cc.usesTexture(otherMode, 1, false);
+                static std::mutex mu;
+                static uint64_t nTex = 0, nNoTex = 0, nT1 = 0;
+                static uint64_t nShadeBlack = 0, nShadeOk = 0, nShadeWhite = 0;
+                static float vmin[4] = {1e9f,1e9f,1e9f,1e9f};
+                static float vmax[4] = {-1e9f,-1e9f,-1e9f,-1e9f};
+                static std::chrono::steady_clock::time_point last;
+                std::lock_guard<std::mutex> lk(mu);
+                if (usesT0) nTex++; else nNoTex++;
+                if (usesT1) nT1++;
+                // Vertex colour census for textured draws (col is rgba float).
+                if (usesT0 && col != nullptr) {
+                    float smin = 1e9f, smax = -1e9f;
+                    for (uint32_t i = 0; i < triCount * 3; i++) {
+                        for (int c = 0; c < 4; c++) {
+                            const float v = col[i * 4 + c];
+                            if (v < vmin[c]) vmin[c] = v;
+                            if (v > vmax[c]) vmax[c] = v;
+                            if (c < 3) {
+                                if (v < smin) smin = v;
+                                if (v > smax) smax = v;
+                            }
+                        }
+                    }
+                    const float mid = 0.5f * (smin + smax);
+                    if (smax < 0.05f) nShadeBlack++;
+                    else if (smin > 0.9f) nShadeWhite++;
+                    else nShadeOk++;
+                    (void)mid;
+                }
+                const auto now = std::chrono::steady_clock::now();
+                if (last.time_since_epoch().count() == 0) {
+                    last = now;
+                } else if (std::chrono::duration<double>(now - last).count() >= 2.0) {
+                    last = now;
+                    const auto &fog = fogColorStack[fogColorStackSize - 1];
+                    const auto &prim = primColorStack[primColorStackSize - 1];
+                    const auto &env = envColorStack[envColorStackSize - 1];
+                    const auto &bl = blendColorStack[blendColorStackSize - 1];
+                    auto hex = [](const hlslpp::float4 &c) {
+                        auto ch = [](float x) {
+                            int v = int(x * 255.0f);
+                            if (v < 0) v = 0;
+                            if (v > 255) v = 255;
+                            return unsigned(v);
+                        };
+                        return (ch(c.x) << 16) | (ch(c.y) << 8) | ch(c.z);
+                    };
+                    auto f4 = [](const hlslpp::float4 &c, int i) {
+                        return float((&c.x)[i]);
+                    };
+                    fprintf(stderr, "[shade] drawTarget=0x%06X w=%u siz=%u\n",
+                            colorImage.address & 0xFFFFFF, (unsigned)colorImage.width,
+                            (unsigned)colorImage.siz);
+                    fprintf(stderr,
+                        "[shade] usesTex0=%llu noTex=%llu usesTex1=%llu | fog=#%06X(a%.2f) "
+                        "prim=#%06X(a%.2f) env=#%06X(a%.2f) blend=#%06X fill=0x%08X | "
+                        "blenderInputs=0x%X forceBlend=%d cvgXAlpha=%d\n",
+                        (unsigned long long)nTex, (unsigned long long)nNoTex,
+                        (unsigned long long)nT1,
+                        hex(fog), f4(fog,3), hex(prim), f4(prim,3),
+                        hex(env), f4(env,3), hex(bl),
+                        fillColorStack[fillColorStackSize - 1],
+                        (unsigned)otherMode.blenderInputs(), (int)otherMode.forceBlend(),
+                        (int)otherMode.cvgXAlpha());
+                    fprintf(stderr,
+                        "[shade] vtxRGB black=%llu ok=%llu white=%llu | "
+                        "min=(%.3f,%.3f,%.3f,%.3f) max=(%.3f,%.3f,%.3f,%.3f)\n",
+                        (unsigned long long)nShadeBlack, (unsigned long long)nShadeOk,
+                        (unsigned long long)nShadeWhite,
+                        vmin[0], vmin[1], vmin[2], vmin[3],
+                        vmax[0], vmax[1], vmax[2], vmax[3]);
+                    fflush(stderr);
+                    nTex = 0; nNoTex = 0; nT1 = 0;
+                    nShadeBlack = 0; nShadeOk = 0; nShadeWhite = 0;
+                    for (int c = 0; c < 4; c++) { vmin[c] = 1e9f; vmax[c] = -1e9f; }
+                }
+            }
+        }
+
+        // ROGUESQ_LOG_FLOOR=1 — census of textured triangles whose screen
+        // centroid falls in the mid-band (y 180..360 of a 480-tall frame),
+        // where the hangar floor garbage lives. Reports tile fmt/siz/line/pal,
+        // tileCount (dual-texel?), UV span, and othermode TLUT.
+        //
+        // ROGUESQ_LOG_I4=1 — session 28: all textured I4 line=4 masks=6/6
+        // draws anywhere on screen, tagged upper/mid/lower by ycen, with shade
+        // RGB. Used to split hangar walls (good) from floor (band).
+        //
+        // ROGUESQ_LOG_MIDTEX=1 — session 30: every textured mid-band draw
+        // (ycen 180..360) with fmt/siz/line/pal/tlut/cc/prim/blender bits,
+        // so CI vs I4 vs shade-only can be re-attributed without FLATTEN.
+        {
+            static const bool s_log = []{
+                const char *e = std::getenv("ROGUESQ_LOG_FLOOR");
+                return e && *e && *e != '0';
+            }();
+            static const bool s_i4 = []{
+                const char *e = std::getenv("ROGUESQ_LOG_I4");
+                return e && *e && *e != '0';
+            }();
+            static const bool s_mid = []{
+                const char *e = std::getenv("ROGUESQ_LOG_MIDTEX");
+                return e && *e && *e != '0';
+            }();
+            rs64_stage_count("drawtris", 500);
+            rs64_stage_add("tris-rdp", triCount, 1000);
+            static const bool s_bbox = []{
+                const char *e = std::getenv("ROGUESQ_LOG_BBOX");
+                return e && *e && *e != '0';
+            }();
+            static const bool s_zsg = []{ const char *e = std::getenv("ROGUESQ_LOG_ZSTATE"); return e && *e && *e != 0x30; }();
+            if (s_log || s_i4 || s_mid || s_bbox || s_zsg) {
+                float ysum = 0, xsum = 0;
+                // Session 32: screen-space bounds. Every attribution since s27
+                // used the centroid, which cannot see a large polygon that
+                // covers the band while its centre sits elsewhere.
+                float ymn = 1e9f, ymx = -1e9f, xmn = 1e9f, xmx = -1e9f;
+                float umin = 1e9f, umax = -1e9f, vmin = 1e9f, vmax = -1e9f;
+                float srmin = 1e9f, srmax = -1e9f, sgmin = 1e9f, sgmax = -1e9f;
+                float sbmin = 1e9f, sbmax = -1e9f;
+                for (uint32_t i = 0; i < triCount * 3; i++) {
+                    const float px = pos[i * PosFloatsPerVertex + 0];
+                    const float py = pos[i * PosFloatsPerVertex + 1];
+                    xsum += px;
+                    ysum += py;
+                    xmn = std::min(xmn, px); xmx = std::max(xmx, px);
+                    ymn = std::min(ymn, py); ymx = std::max(ymx, py);
+                    float u = tc[i * TcFloatsPerVertex + 0];
+                    float v = tc[i * TcFloatsPerVertex + 1];
+                    umin = std::min(umin, u); umax = std::max(umax, u);
+                    vmin = std::min(vmin, v); vmax = std::max(vmax, v);
+                    // col is float RGBA in 0..1 (post /255, possibly signed-wrap raw)
+                    const float *c = col + i * 4;
+                    srmin = std::min(srmin, c[0]); srmax = std::max(srmax, c[0]);
+                    sgmin = std::min(sgmin, c[1]); sgmax = std::max(sgmax, c[1]);
+                    sbmin = std::min(sbmin, c[2]); sbmax = std::max(sbmax, c[2]);
+                }
+                const float ycen = ysum / float(triCount * 3);
+                const float xcen = xsum / float(triCount * 3);
+                const auto &t0_i4 = tiles[tile % RDP_TILES];
+                const auto &cc_i4 = colorCombinerStack[colorCombinerStackSize - 1];
+                const bool usesT0_i4 = cc_i4.usesTexture(otherMode, 0, false);
+                const bool isHangarI4 =
+                    usesT0_i4 &&
+                    t0_i4.fmt == 4 && t0_i4.siz == 0 && t0_i4.line == 4 &&
+                    t0_i4.masks == 6 && t0_i4.maskt == 6;
+                if (s_i4 && isHangarI4) {
+                    const char *band =
+                        (ycen < 180.0f) ? "upper" :
+                        (ycen < 360.0f) ? "mid" : "lower";
+                    static std::mutex mu_i4;
+                    static int total_i4 = 0;
+                    static int logged_i4 = 0;
+                    static uint32_t s_phase_i4 = 0xFFFFFFFFu;
+                    const uint32_t phase = rs64_phase_ord ? rs64_phase_ord() : 0u;
+                    int my_total = 0;
+                    bool do_log = false;
+                    {
+                        std::lock_guard<std::mutex> lk(mu_i4);
+                        if (phase != s_phase_i4) {
+                            s_phase_i4 = phase;
+                            total_i4 = 0;
+                            logged_i4 = 0;
+                        }
+                        my_total = ++total_i4;
+                        // First 40 per phase + every 500th + first of each band key.
+                        if (logged_i4 < 80 || (my_total % 500) == 0) {
+                            logged_i4++;
+                            do_log = true;
+                        }
+                    }
+                    if (do_log) {
+                        const auto &pc = primColorStack[primColorStackSize - 1];
+                        const uint32_t imgAddr = texture.address & 0xFFFFFF;
+                        const float uspan = umax - umin, vspan = vmax - vmin;
+                        std::fprintf(stderr,
+                            "[i4-tri ph%u #%d %s] cen=(%.0f,%.0f) img=0x%06X "
+                            "uv=[%.1f..%.1f, %.1f..%.1f] span=(%.1f,%.1f) "
+                            "shadeR=[%.2f..%.2f] G=[%.2f..%.2f] B=[%.2f..%.2f] "
+                            "primRGBA=(%.2f,%.2f,%.2f,%.2f) filt=%u cycle=%u "
+                            "cms=%u cmt=%u tmem=0x%X\n",
+                            phase, my_total, band, xcen, ycen, imgAddr,
+                            umin, umax, vmin, vmax, uspan, vspan,
+                            srmin, srmax, sgmin, sgmax, sbmin, sbmax,
+                            (float)pc.x, (float)pc.y, (float)pc.z, (float)pc.w,
+                            (unsigned)otherMode.textFilt(),
+                            (unsigned)otherMode.cycleType(),
+                            (unsigned)t0_i4.cms, (unsigned)t0_i4.cmt,
+                            (unsigned)t0_i4.tmem);
+                        std::fflush(stderr);
+                    }
+                }
+                // Mid/lower-band census (all formats). Session 31: hangar multi-
+                // hue survives FORCE_SHADE_WHITE (pure TEXEL), so it is texture
+                // content — but the old mid-only window + first-100 sample
+                // only ever saw shade-only pad draws. Widen to y 100..450 and
+                // always keep textured samples (tiles>0) in the log budget.
+                // ROGUESQ_LOG_ZSTATE=1 (session 43) — raster-state census split
+                // by screen-row window, so the band draws can be compared with
+                // the wall and pad draws that DO paint. Windows are in game-y
+                // (capture = 2.33*game + 151, derived s42): walls 60..140,
+                // band 141..201, pad 220..320. A triangle counts in every window
+                // its ymin..ymax span touches.
+                {
+                    static const bool s_zs = []{
+                        const char *e = std::getenv("ROGUESQ_LOG_ZSTATE");
+                        return e && *e && *e != '0';
